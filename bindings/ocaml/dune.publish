(library
 (name vinary_tree_libdictenstein)
 (public_name vinary-tree-libdictenstein)
 (libraries vinary-tree-interop)
 (foreign_stubs
  (language c)
  (names libdictenstein_stubs)
  (include_dirs include)
  (flags (:standard -std=c17 -Wall -Wextra -Werror)))
 (c_library_flags -llibdictenstein))

(install
 (section lib)
 (package vinary-tree-libdictenstein)
 (files
  (include/libdictenstein.h as include/libdictenstein.h)
  (include/vinary_tree_interop.h as include/vinary_tree_interop.h)
  (include/vinary_tree_ocaml.h as include/vinary_tree_ocaml.h)))
