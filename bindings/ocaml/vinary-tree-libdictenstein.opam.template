opam-version: "2.0"
synopsis: "Fast libdictenstein dictionaries for OCaml"
description: "DynamicDAWG, DoubleArrayTrie, SCDAWG, and persistent ARTrie resources with snapshot-safe cross-project handoff."
maintainer: "Dylon Edwards <dylon.devo@gmail.com>"
authors: ["Dylon Edwards <dylon.devo@gmail.com>"]
license: "Apache-2.0"
homepage: "https://github.com/vinary-tree/libdictenstein"
bug-reports: "https://github.com/vinary-tree/libdictenstein/issues"
dev-repo: "git+https://github.com/vinary-tree/libdictenstein.git"
depends: [
  "dune" {>= "3.20"}
  "ocaml" {>= "5.2"}
  "conf-pkg-config" {build}
  "vinary-tree-interop" {= "4.0.0~rc3"}
  "odoc" {with-doc}
]
depexts: [
  ["libdictenstein-dev"] {os-family = "debian"}
  ["libdictenstein"] {os-distribution = "arch"}
]
build: [
  ["pkg-config" "--exists" "libdictenstein"]
  ["dune" "build" "-p" name "-j" jobs "@install" "@runtest" {with-test} "@doc" {with-doc}]
]
x-maintenance-intent: ["(latest)"]
