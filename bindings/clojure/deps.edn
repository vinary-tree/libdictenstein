{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        io.vinarytree/vinary-tree-interop {:mvn/version "4.0.0-rc.1"}
        io.vinarytree/libdictenstein {:mvn/version "4.0.0-rc.1"}}
 :aliases
 {:test
  {:extra-paths ["test"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
   :override-deps
   {io.vinarytree/vinary-tree-interop
    {:local/root "../../../vinary-tree-interop/bindings/jvm"}
    io.vinarytree/liblevenshtein
    {:local/root "../../../liblevenshtein-rust/bindings/jvm"}
    io.vinarytree/libdictenstein {:local/root "../jvm"}}
   :main-opts ["-m" "vinary-tree.libdictenstein-test-runner"]}
  ;; Producer-only C1-C10 conformance: needs libdictenstein + the canonical
  ;; fixture, never a liblevenshtein transducer. data.json parses the fixture.
  :conformance
  {:extra-paths ["test"]
   :extra-deps {org.clojure/data.json {:mvn/version "2.5.2"}}
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
   :override-deps
   {io.vinarytree/vinary-tree-interop
    {:local/root "../../../vinary-tree-interop/bindings/jvm"}
    io.vinarytree/liblevenshtein
    {:local/root "../../../liblevenshtein-rust/bindings/jvm"}
    io.vinarytree/libdictenstein {:local/root "../jvm"}}
   :main-opts ["-m" "vinary-tree.libdictenstein-conformance-runner"]}
  :profile
  {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
   :override-deps
   {io.vinarytree/vinary-tree-interop
    {:local/root "../../../vinary-tree-interop/bindings/jvm"}
    io.vinarytree/libdictenstein {:local/root "../jvm"}}
   :main-opts ["-m" "vinary-tree.libdictenstein-collection-profile"]}}}
