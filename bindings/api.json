        "UNICODE_SCALAR"
      ],
      "capabilities": [
        "READ",
        "INSERT",
        "SUBSTRING"
      ]
    },
    {
      "kind": "PERSISTENT_ARTRIE",
      "producer": "PersistentARTrieBinding",
