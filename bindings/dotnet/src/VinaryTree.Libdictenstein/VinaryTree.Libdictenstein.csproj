<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>VinaryTree.Libdictenstein</PackageId>
    <Version>4.0.0-rc.4</Version>
    <Description>High-performance modular dictionary backends for .NET</Description>
    <Authors>Dylon Edwards</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/vinary-tree/libdictenstein</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(VinaryTreeInteropRoot)' != ''">
    <ProjectReference Include="$(VinaryTreeInteropRoot)/bindings/dotnet/src/VinaryTree.Interop/VinaryTree.Interop.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(VinaryTreeInteropRoot)' == ''">
    <PackageReference Include="VinaryTree.Interop" Version="4.0.0-rc.4" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../../../README.md" Pack="true" PackagePath="README.md" />
    <None Include="../../native/runtimes/**/*"
          Pack="true"
          PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
