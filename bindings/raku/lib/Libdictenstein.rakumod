sub ldict-dictionary-insert-text-batch(Pointer, Pointer, size_t, size_t is rw --> int32)
    is native(&native-library) is symbol('ldict_dictionary_insert_text_batch') { * }
sub ldict-dictionary-insert-u64-batch(Pointer, Pointer, size_t, size_t is rw --> int32)
    is native(&native-library) is symbol('ldict_dictionary_insert_u64_batch') { * }
sub ldict-dictionary-get-text-batch(Pointer, Pointer, size_t, Pointer, Pointer --> int32)
    is native(&native-library) is symbol('ldict_dictionary_get_text_batch') { * }
sub ldict-dictionary-get-u64-batch(Pointer, Pointer, size_t, Pointer, Pointer --> int32)
    is native(&native-library) is symbol('ldict_dictionary_get_u64_batch') { * }
sub ldict-dictionary-remove-text-batch(Pointer, Pointer, size_t, Pointer --> int32)
    is native(&native-library) is symbol('ldict_dictionary_remove_text_batch') { * }
sub ldict-dictionary-remove-u64-batch(Pointer, Pointer, size_t, Pointer --> int32)
    is native(&native-library) is symbol('ldict_dictionary_remove_u64_batch') { * }
# END GENERATED RAKU ABI CALLS
sub memcpy(Pointer, Pointer, size_t --> Pointer) is native { * }

sub abi-version(--> UInt:D) is export { ldict-abi-version().UInt }
sub api-revision(--> UInt:D) is export { ldict-api-revision().UInt }

sub check-status(Int:D $status, Str:D $operation --> Nil) {
    return if $status == 0;
    X::Libdictenstein.new(
        :$status,
        :$operation,
        detail => (try ldict-last-error-message()) // '',
    ).throw;
}

sub optional-value(Mu $value --> OptionalValue:D) {
    if $value.defined {
        die 'dictionary value is outside uint64'
            unless $value ~~ Int && 0 <= $value <= 2**64 - 1;
        OptionalValue.new(
            value => $value,
            has-value => 1,
            reserved0 => 0, reserved1 => 0, reserved2 => 0, reserved3 => 0,
            reserved4 => 0, reserved5 => 0, reserved6 => 0,
        )
    } else {
        OptionalValue.new(
            value => 0,
            has-value => 0,
            reserved0 => 0, reserved1 => 0, reserved2 => 0, reserved3 => 0,
            reserved4 => 0, reserved5 => 0, reserved6 => 0,
        )
    }
}

sub text-buffer(Mu:D $key, UnitDomain:D $domain --> Blob:D) {
    return Buf.new($key.list) if $domain == BYTE && $key ~~ Blob;
    return $key.encode('utf8') if $key ~~ Str &&
        ($domain == BYTE || $domain == UNICODE-SCALAR);
    die "key is incompatible with $domain";
}

sub u64-buffer(Mu:D $key, UnitDomain:D $domain --> CArray[uint64]) {
    die 'key is incompatible with U64' unless $domain == U64 && $key ~~ Positional;
    my $buffer = CArray[uint64].allocate($key.elems max 1);
    for $key.list.kv -> $index, $unit {
        die 'key unit is outside uint64' unless $unit ~~ Int && 0 <= $unit <= 2**64 - 1;
        $buffer[$index] = $unit;
    }
    $buffer
}

sub raw-pointer(Blob:D $buffer --> Pointer:D) {
    nativecast(Pointer, $buffer)
}

sub recovery-text(Pointer:D $handle, Int:D $field, Int:D $index --> Mu) {
    my Pointer $data .= new;
    my size_t $length = 0;
    my uint8 $present = 0;
    check-status(ldict-recovery-report-text($handle, $field, $index,
        $data, $length, $present), 'recovery-report-text');
    return Nil unless $present;
    my $bytes = buf8.allocate($length);
    memcpy(raw-pointer($bytes), $data, $length) if $length;
    $bytes.decode('utf8')
}

sub recovery-report-from(Pointer:D $handle --> PersistentRecoveryReport:D) {
    die 'native recovery constructor returned null report' unless $handle;
    LEAVE ldict-recovery-report-free($handle);
    my uint32 $mode = 0;
    my uint64 $records = 0;
    my uint64 $terms = 0;
    my uint64 $duration = 0;
    my size_t $archive-count = 0;
    check-status(ldict-recovery-report-summary($handle, $mode, $records,
        $terms, $duration, $archive-count), 'recovery-report-summary');
    my @segments;
    for ^$archive-count -> $index {
        @segments.push(IO::Path.new(recovery-text($handle, 3, $index)));
    }
    my $corrupted-file = recovery-text($handle, 1, 0);
    my $reason = recovery-text($handle, 2, 0);
    PersistentRecoveryReport.new(
        mode => RecoveryMode($mode),
        records-replayed => $records.UInt,
        terms-recovered => $terms.UInt,
        duration-ms => $duration.UInt,
        corrupted-file => $corrupted-file.defined
            ?? IO::Path.new($corrupted-file) !! IO::Path,
        corruption-reason => $reason.defined ?? $reason !! Str,
        archive-segments => @segments,
    )
}

sub descriptor-arena(Mu $descriptor-type, @descriptors --> Blob:D) {
    my $width = nativesizeof($descriptor-type);
    my $arena = buf8.allocate((@descriptors.elems * $width) max 1);
    my $base = raw-pointer($arena);
    for @descriptors.kv -> $index, $descriptor {
        memcpy(
            Pointer.new($base + $index * $width),
            nativecast(Pointer, $descriptor),
            $width,
        );
    }
    $arena
}

sub pairs-from(Mu:D $entries --> Array:D) {
    $entries.list.map({ $_ ~~ Pair ?? $_ !! ($_ => Nil) }).Array
}

sub key-units(Mu:D $key, UnitDomain:D $domain --> Array:D) {
    if $domain == U64 {
        u64-buffer($key, $domain);
        return $key.list.Array;
    }
    my $bytes = text-buffer($key, $domain);
    $domain == BYTE ?? $bytes.list.Array !! $key.ords.Array
}

sub compare-units(Positional:D $left, Positional:D $right --> Int:D) {
    for ^($left.elems min $right.elems) -> $index {
        return -1 if $left[$index] < $right[$index];
        return 1 if $left[$index] > $right[$index];
    }
    $left.elems <=> $right.elems
}

class DictionaryIterator does Iterator {
    has InteropAccess::DictionaryType:D $!view is required;
    has InteropAccess::EntriesType:D $!cursor is required;
    has Iterator:D $!iterator is required;
    has UnitDomain:D $.unit-domain is required;
    has Bool $!closed = False;

    submethod BUILD(:$view!, :$cursor!, :$iterator!, :$unit-domain!) {
        $!view := $view;
        $!cursor := $cursor;
        $!iterator := $iterator;
        $!unit-domain := $unit-domain;
    }

    method !close(--> Nil) {
        return if $!closed;
        $!closed = True;
        try $!cursor.close;
        try $!view.close;
    }

    method close(--> Nil) { self!close }

    method pull-one() {
        my \entry = $!iterator.pull-one;
        if entry =:= IterationEnd {
            self!close;
            return IterationEnd;
        }
        my $key = do given $!unit-domain {
            when BYTE { Buf.new(entry.units) }
            when UNICODE-SCALAR { entry.units.map(*.chr).join }
            when U64 { entry.units.Array }
        };
        $key => (entry.value.defined ?? entry.value !! Nil)
    }

    submethod DESTROY { self!close }
}

class DictionaryEntriesIterator does Iterator {
    has Mu:D $!cursor is required;
    has @!buffer;
    has Bool $!finished = False;

    submethod BUILD(:$cursor!) { $!cursor := $cursor }

    method pull-one() {
        while !@!buffer {
            return IterationEnd if $!finished;
            my $batch = $!cursor.next-batch;
            unless $batch.defined {
                $!finished = True;
                $!cursor.close;
                return IterationEnd;
            }
            @!buffer = $batch.entries;
            $batch.release;
        }
        my $entry = @!buffer.shift;
        my $key = do given $!cursor.unit-domain {
            when BYTE { Buf.new($entry.units) }
            when UNICODE-SCALAR { $entry.units.map(*.chr).join }
            when U64 { $entry.units.Array }
        };
        $key => ($entry.value.defined ?? $entry.value !! Nil)
    }

    submethod DESTROY { try $!cursor.close unless $!finished }
}

# One cursor owns the captured native revision(s). A page lease must be released
# before another page, reduction, cancellation, or close operation.
class DictionaryEntriesView does Iterable is export {
    has Pointer $!handle is required;
    has UnitDomain:D $.unit-domain is required;
    has EntriesInfo:D $.info is required;
    has Bool $!batch-active = False;
    has UInt $!generation = 0;
    has Bool $!reducing = False;
    has Bool $!iterator-created = False;
    has Bool $!closed = False;

    submethod BUILD(Pointer:D :$handle!, UnitDomain:D :$unit-domain!,
        EntriesInfo:D :$info!) {
        $!handle = $handle;
        $!unit-domain = $unit-domain;
        $!info = $info;
    }

    method opened(--> Bool:D) { !$!closed }

    method known-length(--> Int) {
        $!info.flags +& InteropAccess::ExactLengthFlag
            ?? $!info.exact-len.Int !! Int
    }

    method next-batch(BatchLimits:D $limits = BatchLimits.new --> Mu) {
        die 'entry view is closed' if $!closed;
        die 'entry batch is in use' if $!batch-active || $!reducing;
        my $view = BatchView.new;
        my $status = ldict-entry-cursor-next($!handle,
            nativecast(Pointer, $limits), nativecast(Pointer, $view));
        return Nil if $status == STATUS-END;
        check-status($status, 'entry-cursor-next');
        $!batch-active = True;
        $!generation = $view.generation.UInt;
        NativeEntryBatch.new(cursor => self, :$view)
    }

    method release-batch(UInt:D $generation --> Nil) {
        die 'entry view is closed' if $!closed;
        die 'no entry batch is active' unless $!batch-active;
        check-status(ldict-entry-cursor-release($!handle, $generation),
            'entry-cursor-release');
        $!batch-active = False;
        $!generation = 0;
    }

    method reduce(&operation, BatchLimits:D $limits = BatchLimits.new --> Int:D) {
        die 'entry view is closed' if $!closed;
        die 'entry batch is in use' if $!batch-active || $!reducing;
        my $failure;
        my &callback = -> Pointer $context, Pointer $view-pointer --> int32 {
            my int32 $status = STATUS-PROVIDER-ERROR;
            try {
                my $view = BatchView.new;
                memcpy(nativecast(Pointer, $view), $view-pointer,
                    nativesizeof(BatchView));
                my $result = operation(NativeEntryBatch.new(
                    cursor => self, :$view, borrowed => True).entries);
                $status = $result === False ?? STATUS-END !! STATUS-OK;
                CATCH {
                    default {
                        $failure = $_;
                        $status = STATUS-PROVIDER-ERROR;
                    }
                }
            }
            $status
        };
        my size_t $count = 0;
        $!reducing = True;
        LEAVE $!reducing = False;
        my $status = ldict-entry-cursor-reduce($!handle,
            nativecast(Pointer, $limits), &callback, Pointer, $count);
        $failure.throw if $failure.defined;
        check-status($status, 'entry-cursor-reduce');
        $count.Int
    }

    method cancel(--> Nil) {
        die 'entry view is closed' if $!closed;
        die 'entry batch is in use' if $!batch-active || $!reducing;
        check-status(ldict-entry-cursor-cancel($!handle), 'entry-cursor-cancel');
    }

    method close(--> Nil) {
        return if $!closed;
        die 'entry reducer is active' if $!reducing;
        self.release-batch($!generation) if $!batch-active;
        check-status(ldict-entry-cursor-free($!handle), 'entry-cursor-free');
        $!handle = Pointer;
        $!closed = True;
    }

    method iterator(--> Iterator:D) {
        die 'entry view has already been iterated' if $!iterator-created;
        $!iterator-created = True;
        DictionaryEntriesIterator.new(cursor => self)
    }

    method Seq(--> Seq:D) { Seq.new(self.iterator) }
    method list(--> List:D) { self.Seq.list }
    submethod DESTROY { try self.close }
}

class LookupResult is export {
    has Bool:D $.found is required;
    has UInt $.value;
}

class ValueDifference is export {
    has Mu $.key is required;
    has Mu $.left;
    has Mu $.right;
}

class ValueDiffIterator does Iterator {
    has Mu:D $!cursor is required;
    has @!buffer;
    has Bool $!finished = False;
    submethod BUILD(:$cursor!) { $!cursor := $cursor }

    method pull-one() {
        while !@!buffer {
            return IterationEnd if $!finished;
            my $page = $!cursor.next-batch;
            unless $page.defined {
                $!finished = True;
                $!cursor.close;
                return IterationEnd;
            }
            @!buffer = $page;
        }
        @!buffer.shift
    }

    submethod DESTROY { try $!cursor.close unless $!finished }
}

# Each page is copied into Raku objects and its native lease is released before
# next-batch returns. The cursor still owns both captured revisions until close.
class ValueDiffView does Iterable is export {
    has Pointer $!handle is required;
    has UnitDomain:D $.unit-domain is required;
    has Bool $!iterator-created = False;
    has Bool $!closed = False;

    submethod BUILD(Pointer:D :$handle!, UnitDomain:D :$unit-domain!) {
        $!handle = $handle;
        $!unit-domain = $unit-domain;
    }

    method opened(--> Bool:D) { !$!closed }

    method next-batch(BatchLimits:D $limits = BatchLimits.new --> Mu) {
        die 'value-difference view is closed' if $!closed;
        my $page = ValueDiffBatchView.new;
        my $status = ldict-value-diff-cursor-next($!handle,
            nativecast(Pointer, $limits), nativecast(Pointer, $page));
        return Nil if $status == STATUS-END;
        check-status($status, 'value-diff-cursor-next');
        my UInt $generation = $page.generation.UInt;
        my @results = do {
            LEAVE check-status(ldict-value-diff-cursor-release($!handle,
                $generation), 'value-diff-cursor-release');
            my @decoded;
            my $width = $!unit-domain == BYTE ?? 1 !!
                $!unit-domain == UNICODE-SCALAR ?? 4 !! 8;
            for ^$page.entry-count -> $index {
                my $descriptor = ValueDiffEntry.new;
                memcpy(nativecast(Pointer, $descriptor),
                    Pointer.new($page.entries + $index * nativesizeof(ValueDiffEntry)),
                    nativesizeof(ValueDiffEntry));
                my $storage = buf8.allocate($descriptor.unit-len * $width);
                memcpy(raw-pointer($storage),
                    Pointer.new($page.units + $descriptor.unit-offset * $width),
                    $storage.elems) if $storage.elems;
                my $key = do given $!unit-domain {
                    when BYTE { Buf.new($storage.list) }
                    when UNICODE-SCALAR {
                        my $units = CArray[uint32].allocate($descriptor.unit-len);
                        memcpy(nativecast(Pointer, $units), raw-pointer($storage),
                            $storage.elems) if $storage.elems;
                        (^$descriptor.unit-len).map({ $units[$_].chr }).join
                    }
                    when U64 {
                        my $units = CArray[uint64].allocate($descriptor.unit-len);
                        memcpy(nativecast(Pointer, $units), raw-pointer($storage),
                            $storage.elems) if $storage.elems;
                        (^$descriptor.unit-len).map({ $units[$_].UInt }).Array
                    }
                };
                @decoded.push(ValueDifference.new(:$key,
                    left => $descriptor.left-has-value
                        ?? $descriptor.left-value.UInt !! Nil,
                    right => $descriptor.right-has-value
                        ?? $descriptor.right-value.UInt !! Nil));
            }
            @decoded.Array
        };
        @results.Array
    }

    method reduce(&operation, BatchLimits:D $limits = BatchLimits.new --> Int:D) {
        my $count = 0;
        loop {
            my $page = self.next-batch($limits);
            last unless $page.defined;
            $count += $page.elems;
            last if operation($page) === False;
        }
        $count
    }

    method cancel(--> Nil) {
        die 'value-difference view is closed' if $!closed;
        check-status(ldict-value-diff-cursor-cancel($!handle),
            'value-diff-cursor-cancel');
    }

    method close(--> Nil) {
        return if $!closed;
        check-status(ldict-value-diff-cursor-free($!handle),
            'value-diff-cursor-free');
        $!handle = Pointer;
        $!closed = True;
    }

    method iterator(--> Iterator:D) {
        die 'value-difference view has already been iterated'
            if $!iterator-created;
        $!iterator-created = True;
        ValueDiffIterator.new(cursor => self)
    }

    method Seq(--> Seq:D) { Seq.new(self.iterator) }
    method list(--> List:D) { self.Seq.list }
    submethod DESTROY { try self.close }
}

class Dictionary does Associative does Iterable is export {
    has Pointer $!handle is required;
    has UnitDomain:D $.unit-domain is required;
    has PersistentRecoveryReport $.recovery-report;
    has Bool $!closed = False;

    submethod BUILD(Pointer:D :$handle!, UnitDomain:D :$unit-domain!,
        PersistentRecoveryReport :$recovery-report) {
        $!handle = $handle;
        $!unit-domain = $unit-domain;
        $!recovery-report = $recovery-report if $recovery-report.defined;
    }

    method !handle(--> Pointer:D) {
        X::Libdictenstein.new(
            status => 8,
            operation => 'dictionary',
            detail => 'dictionary is closed',
        ).throw if $!closed;
        $!handle
    }

    method close(--> Nil) {
        return if $!closed;
        my $handle = $!handle;
        $!closed = True;
        $!handle = Pointer;
        ldict-dictionary-free($handle) if $handle;
    }

    method opened(--> Bool:D) { !$!closed }
    submethod DESTROY { self.close }

    method kind(--> DictionaryKind:D) {
        my uint32 $output = 0;
        check-status(ldict-dictionary-kind(self!handle, $output), 'dictionary-kind');
        DictionaryKind($output)
    }

    method capabilities(--> UInt:D) {
        my uint64 $output = 0;
        check-status(ldict-dictionary-capabilities(self!handle, $output),
            'dictionary-capabilities');
        $output.UInt
    }

    method elems(--> Int:D) {
        my size_t $output = 0;
        check-status(ldict-dictionary-len(self!handle, $output), 'dictionary-len');
        $output.Int
    }

    method !text-call(Str:D $stem, Mu:D $key --> Bool:D) {
        my $buffer = text-buffer($key, $!unit-domain);
        my uint8 $output = 0;
        my $status = $stem eq 'contains'
            ?? ldict-dictionary-contains-text(self!handle, raw-pointer($buffer),
                $buffer.elems, $output)
            !! ldict-dictionary-remove-text(self!handle, raw-pointer($buffer),
                $buffer.elems, $output);
        check-status($status, "dictionary-{$stem}-text");
        so $output
    }

    method !u64-call(Str:D $stem, Mu:D $key --> Bool:D) {
        my $buffer = u64-buffer($key, $!unit-domain);
        my uint8 $output = 0;
        my $status = $stem eq 'contains'
            ?? ldict-dictionary-contains-u64(self!handle, nativecast(Pointer, $buffer),
                $key.elems, $output)
            !! ldict-dictionary-remove-u64(self!handle, nativecast(Pointer, $buffer),
                $key.elems, $output);
        check-status($status, "dictionary-{$stem}-u64");
        so $output
    }

    method EXISTS-KEY(Mu:D $key --> Bool:D) {
        $!unit-domain == U64 ?? self!u64-call('contains', $key) !!
            self!text-call('contains', $key)
    }

    method AT-KEY(Mu:D $key --> Mu) {
        my uint8 $found = 0;
        my $value = OptionalValue.new;
        my $status;
        if $!unit-domain == U64 {
            my $buffer = u64-buffer($key, $!unit-domain);
            $status = ldict-dictionary-get-u64(self!handle,
                nativecast(Pointer, $buffer), $key.elems, $found, $value);
        } else {
            my $buffer = text-buffer($key, $!unit-domain);
            $status = ldict-dictionary-get-text(self!handle, raw-pointer($buffer),
                $buffer.elems, $found, $value);
        }
        check-status($status, 'dictionary-get');
        return Nil unless $found;
        $value.has-value ?? $value.value.UInt !! Nil
    }

    method ASSIGN-KEY(Mu:D $key, Mu $value --> Mu) {
        my uint8 $inserted = 0;
        my $optional = optional-value($value);
        my $status;
        if $!unit-domain == U64 {
            my $buffer = u64-buffer($key, $!unit-domain);
            $status = ldict-dictionary-insert-u64-value(self!handle,
                nativecast(Pointer, $buffer), $key.elems, $optional.value,
                $optional.has-value, $inserted);
        } else {
            my $buffer = text-buffer($key, $!unit-domain);
            $status = ldict-dictionary-insert-text-value(self!handle,
                raw-pointer($buffer), $buffer.elems, $optional.value,
                $optional.has-value, $inserted);
        }
        check-status($status, 'dictionary-insert');
        $value
    }

    method DELETE-KEY(Mu:D $key --> Mu) {
        my $present = self.EXISTS-KEY($key);
        my $old = $present ?? self.AT-KEY($key) !! Nil;
        $!unit-domain == U64 ?? self!u64-call('remove', $key) !!
            self!text-call('remove', $key);
        $old
    }

    method clear(--> Dictionary:D) {
        check-status(ldict-dictionary-clear(self!handle), 'dictionary-clear');
        self
    }

    method compact(--> Int:D) {
        my size_t $reclaimed = 0;
        check-status(ldict-dictionary-compact(self!handle, $reclaimed),
            'dictionary-compact');
        $reclaimed.Int
    }

    method checkpoint(--> Dictionary:D) {
        check-status(ldict-dictionary-checkpoint(self!handle), 'dictionary-checkpoint');
        self
    }

    method checkpoint-report(--> PersistentCheckpointReport:D) {
        my $before = self.elems.UInt;
        my $started = now;
        self.checkpoint;
        my $elapsed = ((now - $started) * 1000).Int;
        $elapsed = 0 if $elapsed < 0;
        PersistentCheckpointReport.new(
            duration-ms => $elapsed.UInt,
            visible-count-before => $before,
            visible-count-after => self.elems.UInt,
        )
    }

    method snapshot(--> InteropAccess::DictionaryType:D) {
        my $raw = RawResource.new;
        check-status(ldict-dictionary-resource(self!handle, $raw), 'dictionary-resource');
        my $owned = InteropAccess::borrow($raw);
        my $live = InteropAccess::open-dictionary($owned);
        LEAVE $live.close;
        $live.snapshot
    }

    method iterator(--> Iterator:D) {
        my $view = self.snapshot;
        my $cursor = InteropAccess::open-entries($view);
        DictionaryIterator.new(
            :$view,
            :$cursor,
            iterator => $cursor.iterator,
            unit-domain => $!unit-domain,
        )
    }

    method Seq(--> Seq:D) { Seq.new(self.iterator) }
    method list(--> List:D) { self.Seq.list }

    method insert-batch(Mu:D $entries --> Int:D) {
        my @pairs = pairs-from($entries);
        my size_t $inserted = 0;
        if $!unit-domain == U64 {
            my @buffers;
            @buffers.push(u64-buffer(.key, $!unit-domain)) for @pairs;
            my @descriptors;
            for @pairs.kv -> $index, $pair {
                my $optional = optional-value($pair.value);
                @descriptors.push(U64Entry.new(
                    data => nativecast(Pointer, @buffers[$index]),
                    len => $pair.key.elems,
                    mapped-value => $optional.value,
                    has-value => $optional.has-value,
                    reserved0 => 0, reserved1 => 0, reserved2 => 0, reserved3 => 0,
                    reserved4 => 0, reserved5 => 0, reserved6 => 0,
                ));
            }
            my $arena = descriptor-arena(U64Entry, @descriptors);
            check-status(ldict-dictionary-insert-u64-batch(self!handle,
                raw-pointer($arena),
                @pairs.elems, $inserted), 'dictionary-insert-u64-batch');
        } else {
            my @buffers;
            @buffers.push(text-buffer(.key, $!unit-domain)) for @pairs;
            my @descriptors;
            for @pairs.kv -> $index, $pair {
                my $optional = optional-value($pair.value);
                @descriptors.push(TextEntry.new(
                    data => raw-pointer(@buffers[$index]),
                    len => @buffers[$index].elems,
                    mapped-value => $optional.value,
                    has-value => $optional.has-value,
                    reserved0 => 0, reserved1 => 0, reserved2 => 0, reserved3 => 0,
                    reserved4 => 0, reserved5 => 0, reserved6 => 0,
                ));
            }
            my $arena = descriptor-arena(TextEntry, @descriptors);
            check-status(ldict-dictionary-insert-text-batch(self!handle,
                raw-pointer($arena),
                @pairs.elems, $inserted), 'dictionary-insert-text-batch');
        }
        $inserted.Int
    }

    method lookup-batch(Mu:D $keys --> List:D) {
        my @keys = $keys.list;
        my @buffers;
        my @descriptors;
        for @keys -> $key {
            if $!unit-domain == U64 {
                my $buffer = u64-buffer($key, $!unit-domain);
                @buffers.push($buffer);
                @descriptors.push(U64Key.new(
                    data => nativecast(Pointer, $buffer), len => $buffer.elems));
            } else {
                my $buffer = text-buffer($key, $!unit-domain);
                @buffers.push($buffer);
                @descriptors.push(TextKey.new(
                    data => raw-pointer($buffer), len => $buffer.elems));
            }
        }
        my $arena = descriptor-arena(
            $!unit-domain == U64 ?? U64Key !! TextKey, @descriptors);
        my $found = CArray[uint8].allocate(@keys.elems);
        my $width = nativesizeof(OptionalValue);
        my $values = buf8.allocate(@keys.elems * $width);
        my $status = $!unit-domain == U64
            ?? ldict-dictionary-get-u64-batch(self!handle,
                raw-pointer($arena), @keys.elems,
                nativecast(Pointer, $found), raw-pointer($values))
            !! ldict-dictionary-get-text-batch(self!handle,
                raw-pointer($arena), @keys.elems,
                nativecast(Pointer, $found), raw-pointer($values));
        check-status($status, 'dictionary-lookup-batch');
        my @results;
        for ^@keys.elems -> $index {
            my $value = OptionalValue.new;
            memcpy(nativecast(Pointer, $value),
                Pointer.new(raw-pointer($values) + $index * $width), $width);
            @results.push($value.has-value
                ?? LookupResult.new(found => so $found[$index],
                    value => $value.value.UInt)
                !! LookupResult.new(found => so $found[$index]));
        }
        @results.List
    }

    method remove-batch(Mu:D $keys --> List:D) {
        my @keys = $keys.list;
        my @buffers;
        my @descriptors;
        for @keys -> $key {
            if $!unit-domain == U64 {
                my $buffer = u64-buffer($key, $!unit-domain);
                @buffers.push($buffer);
                @descriptors.push(U64Key.new(
                    data => nativecast(Pointer, $buffer), len => $buffer.elems));
            } else {
                my $buffer = text-buffer($key, $!unit-domain);
                @buffers.push($buffer);
                @descriptors.push(TextKey.new(
                    data => raw-pointer($buffer), len => $buffer.elems));
            }
        }
        my $arena = descriptor-arena(
            $!unit-domain == U64 ?? U64Key !! TextKey, @descriptors);
        my $removed = CArray[uint8].allocate(@keys.elems);
        my $status = $!unit-domain == U64
            ?? ldict-dictionary-remove-u64-batch(self!handle,
                raw-pointer($arena), @keys.elems, nativecast(Pointer, $removed))
            !! ldict-dictionary-remove-text-batch(self!handle,
                raw-pointer($arena), @keys.elems, nativecast(Pointer, $removed));
        check-status($status, 'dictionary-remove-batch');
        (^@keys.elems).map({ so $removed[$_] }).List
    }

    method prefix-view(Mu:D $prefix, Positional:D :$excluding = []
        --> DictionaryEntriesView:D) {
        X::Libdictenstein.new(status => STATUS-UNSUPPORTED,
            operation => 'dictionary-prefix-entries-open',
            detail => 'native API revision 13 is required').throw
            if api-revision() < 13;
        my @buffers;
        my $prefix-buffer = $!unit-domain == U64
            ?? u64-buffer($prefix, $!unit-domain)
            !! text-buffer($prefix, $!unit-domain);
        @buffers.push($prefix-buffer);
        my $prefix-key = UnitKey.new(
            data => $!unit-domain == U64
                ?? nativecast(Pointer, $prefix-buffer)
                !! raw-pointer($prefix-buffer),
            len => $!unit-domain == U64
                ?? $prefix.elems !! $prefix-buffer.elems);
        my @descriptors;
        for ^$excluding.elems -> $index {
            my $excluded = $excluding[$index];
            my $buffer = $!unit-domain == U64
                ?? u64-buffer($excluded, $!unit-domain)
                !! text-buffer($excluded, $!unit-domain);
            @buffers.push($buffer);
            @descriptors.push(UnitKey.new(
                data => $!unit-domain == U64
                    ?? nativecast(Pointer, $buffer)
                    !! raw-pointer($buffer),
                len => $!unit-domain == U64
                    ?? $excluded.elems !! $buffer.elems));
        }
        my $arena = descriptor-arena(UnitKey, @descriptors);
        my Pointer $cursor .= new;
        my $info = EntriesInfo.new;
        check-status(ldict-dictionary-prefix-entries-open(self!handle,
            nativecast(Pointer, $prefix-key), raw-pointer($arena),
            @descriptors.elems, $cursor, nativecast(Pointer, $info)),
            'dictionary-prefix-entries-open');
        my $transferred = False;
        LEAVE ldict-entry-cursor-free($cursor) if $cursor && !$transferred;
        die 'prefix cursor returned a different unit domain'
            unless $info.unit-domain == $!unit-domain.Int;
        my $view = DictionaryEntriesView.new(
            handle => $cursor, unit-domain => $!unit-domain, :$info);
        $transferred = True;
        $view
    }

    method excluding-prefix-view(Mu:D $excluded
        --> DictionaryEntriesView:D) {
        my $empty = $!unit-domain == U64 ?? []
            !! $!unit-domain == BYTE ?? Buf.new !! '';
        self.prefix-view($empty, excluding => [$($excluded)])
    }

    method algebra-view(Dictionary:D $right,
        AlgebraOperation:D $operation = ALGEBRA-UNION,
        ValueMerge:D $merge = VALUE-MERGE-LAST --> DictionaryEntriesView:D) {
        die 'dictionary domains must match' unless $!unit-domain == $right.unit-domain;
        my Pointer $cursor .= new;
        my $info = EntriesInfo.new;
        check-status(ldict-dictionary-algebra-entries-open(self!handle,
            $right!handle, $operation.Int, $merge.Int, $cursor,
            nativecast(Pointer, $info)), 'dictionary-algebra-entries-open');
        my $transferred = False;
        LEAVE ldict-entry-cursor-free($cursor) if $cursor && !$transferred;
        die 'algebra cursor returned a different unit domain'
            unless $info.unit-domain == $!unit-domain.Int;
        my $view = DictionaryEntriesView.new(
            handle => $cursor, unit-domain => $!unit-domain, :$info);
        $transferred = True;
        $view
    }

    method union-view(Dictionary:D $right,
        ValueMerge:D :$merge = VALUE-MERGE-LAST --> DictionaryEntriesView:D) {
        self.algebra-view($right, ALGEBRA-UNION, $merge)
    }

    method intersection-view(Dictionary:D $right,
        ValueMerge:D :$merge = VALUE-MERGE-LATTICE-MEET
        --> DictionaryEntriesView:D) {
        self.algebra-view($right, ALGEBRA-INTERSECTION, $merge)
    }

    method difference-view(Dictionary:D $right --> DictionaryEntriesView:D) {
        self.algebra-view($right, ALGEBRA-DIFFERENCE, VALUE-MERGE-FIRST)
    }

    method symmetric-difference-view(Dictionary:D $right
        --> DictionaryEntriesView:D) {
        self.algebra-view($right, ALGEBRA-SYMMETRIC-DIFFERENCE,
            VALUE-MERGE-FIRST)
    }

    method value-difference-view(Dictionary:D $right --> ValueDiffView:D) {
        die 'dictionary domains must match' unless $!unit-domain == $right.unit-domain;
        X::Libdictenstein.new(status => STATUS-UNSUPPORTED,
            operation => 'dictionary-value-diff-open',
            detail => 'native API revision 13 is required').throw
            if api-revision() < 13;
        my Pointer $cursor .= new;
        my uint32 $domain = 0;
        check-status(ldict-dictionary-value-diff-open(self!handle,
            $right!handle, $cursor, $domain), 'dictionary-value-diff-open');
        my $transferred = False;
        LEAVE ldict-value-diff-cursor-free($cursor) if $cursor && !$transferred;
        die 'value-difference cursor returned a different unit domain'
            unless $domain == $!unit-domain.Int;
        my $view = ValueDiffView.new(
            handle => $cursor, unit-domain => $!unit-domain);
        $transferred = True;
        $view
    }

    method algebra(Dictionary:D $right, AlgebraOperation:D $operation = ALGEBRA-UNION,
        ValueMerge:D $merge = VALUE-MERGE-LAST --> Dictionary:D) {
        die 'dictionary domains must match' unless $!unit-domain == $right.unit-domain;
        my Pointer $output .= new;
        check-status(ldict-dictionary-algebra(self!handle, $right!handle,
            $operation.Int, $merge.Int, $output), 'dictionary-algebra');
        Dictionary.new(handle => $output, unit-domain => $!unit-domain)
    }

    method union(Dictionary:D $right, ValueMerge:D :$merge = VALUE-MERGE-LAST
        --> Dictionary:D) {
        self.algebra($right, ALGEBRA-UNION, $merge)
    }

    method intersection(Dictionary:D $right,
        ValueMerge:D :$merge = VALUE-MERGE-LATTICE-MEET --> Dictionary:D) {
        self.algebra($right, ALGEBRA-INTERSECTION, $merge)
    }

    method difference(Dictionary:D $right --> Dictionary:D) {
        self.algebra($right, ALGEBRA-DIFFERENCE, VALUE-MERGE-FIRST)
    }

    method symmetric-difference(Dictionary:D $right --> Dictionary:D) {
        self.algebra($right, ALGEBRA-SYMMETRIC-DIFFERENCE, VALUE-MERGE-FIRST)
    }

    method contains-substring(Str:D $pattern --> Bool:D) {
        my $buffer = $pattern.encode('utf8');
        my uint8 $output = 0;
        check-status(ldict-scdawg-contains-substring(self!handle, raw-pointer($buffer),
            $buffer.elems, $output), 'scdawg-contains-substring');
        so $output
    }

    method substring-frequency(Str:D $pattern --> Int:D) {
        my $buffer = $pattern.encode('utf8');
        my size_t $output = 0;
        check-status(ldict-scdawg-substring-frequency(self!handle, raw-pointer($buffer),
            $buffer.elems, $output), 'scdawg-substring-frequency');
        $output.Int
    }

    method vocabulary-insert(Str:D $term --> UInt:D) {
        my $buffer = $term.encode('utf8');
        my uint64 $index = 0;
        check-status(ldict-vocab-insert-term(self!handle,
            raw-pointer($buffer), $buffer.elems, $index),
            'vocab-insert-term');
        $index.UInt
    }

    method vocabulary-insert-batch(Mu:D $terms --> List:D) {
        my @terms = $terms.list;
        for @terms -> $term {
            die 'vocabulary batch requires text terms' unless $term ~~ Str;
        }
        my @buffers;
        @buffers.push(.encode('utf8')) for @terms;
        my @descriptors;
        for @buffers -> $buffer {
            @descriptors.push(TextKey.new(
                data => raw-pointer($buffer), len => $buffer.elems));
        }
        my $arena = descriptor-arena(TextKey, @descriptors);
        my $indices = CArray[uint64].allocate(@terms.elems);
        my size_t $completed = 0;
        check-status(ldict-vocab-insert-batch(self!handle,
            raw-pointer($arena), @terms.elems,
            nativecast(Pointer, $indices), $completed),
            'vocab-insert-batch');
        my @assigned;
        @assigned.push($indices[$_].UInt) for ^@terms.elems;
        @assigned.List
    }

    method vocabulary-term(UInt:D $index --> Str) {
        my size_t $required = 0;
        my uint8 $found = 0;
        check-status(ldict-vocab-get-term(self!handle, $index, Pointer, 0,
            $required, $found), 'vocab-get-term');
        return Str unless $found;
        my $buffer = buf8.allocate($required);
        check-status(ldict-vocab-get-term(self!handle, $index,
            nativecast(Pointer, $buffer), $required, $required, $found), 'vocab-get-term');
        $found ?? $buffer.decode('utf8') !! Str
    }
}

sub dictionary-from(Pointer:D $handle, UnitDomain:D $domain,
    PersistentRecoveryReport :$recovery-report --> Dictionary:D) {
    X::Libdictenstein.new(
        status => 4,
        operation => 'constructor',
        detail => 'native constructor returned null',
    ).throw unless $handle;
    Dictionary.new(:$handle, unit-domain => $domain, :$recovery-report)
}

sub dictionary-from-recovery(Pointer:D $handle, UnitDomain:D $domain,
    Pointer:D $report-handle --> Dictionary:D) {
    my $transferred = False;
    LEAVE ldict-dictionary-free($handle) if $handle && !$transferred;
    my $report = recovery-report-from($report-handle);
    my $dictionary = dictionary-from($handle, $domain, recovery-report => $report);
    $transferred = True;
    $dictionary
}

sub dynamic-dawg(UnitDomain:D $domain = UNICODE-SCALAR --> Dictionary:D) is export {
    my Pointer $output .= new;
    check-status(ldict-dynamic-dawg-new($domain.Int, $output), 'dynamic-dawg-new');
    dictionary-from($output, $domain)
}

# A single native batch into an empty DynamicDAWG selects its minimal
# freeze-once builder. Ordered input avoids the native sorting pass.
sub dynamic-dawg-from(Mu:D $entries, UnitDomain:D :$domain = UNICODE-SCALAR
    --> Dictionary:D) is export {
    my @pairs = pairs-from($entries);
    my $dictionary = dynamic-dawg($domain);
    my $published = False;
    LEAVE $dictionary.close unless $published;
    $dictionary.insert-batch(@pairs) if @pairs.elems;
    $published = True;
    $dictionary
}

sub sorted-dawg(Mu:D $entries, UnitDomain:D :$domain = UNICODE-SCALAR
    --> Dictionary:D) is export {
    my @pairs = pairs-from($entries);
    my $previous;
    for @pairs -> $pair {
        my $units = key-units($pair.key, $domain);
        die 'sorted-dawg requires lexicographically nondecreasing keys'
            if $previous.defined && compare-units($previous, $units) > 0;
        $previous = $units;
    }
    dynamic-dawg-from(@pairs, :$domain)
}

# PathMap is an ordinary exact-key dictionary. The suffix-source index is not:
# its duplicate records must not be coerced into Associative semantics.
sub pathmap(UnitDomain:D $domain = UNICODE-SCALAR --> Dictionary:D) is export {
    X::Libdictenstein.new(
        status => 6,
        operation => 'pathmap-new',
        detail => 'native API revision 8 is required',
    ).throw if api-revision() < 8;
    my Pointer $output .= new;
    check-status(ldict-pathmap-new($domain.Int, $output), 'pathmap-new');
    dictionary-from($output, $domain)
}

class SourceRecord is export {
    has Int:D $.source-id is required;
    has Str:D $.text is required;
    has Mu $.value;
}

class SuffixIdentity is export {
    has Str:D $.resource-family = 'suffix-source';
    has UInt:D $.producer-id is required;
    has UInt:D $.revision is required;
}

class SuffixSnapshot does Iterable is export {
    has Pointer $!handle is required;
    has UnitDomain:D $.unit-domain is required;
    has Bool $!closed = False;

    submethod BUILD(Pointer:D :$handle!, UnitDomain:D :$unit-domain!) {
        $!handle = $handle;
        $!unit-domain = $unit-domain;
    }

    method !handle(--> Pointer:D) {
        X::Libdictenstein.new(status => 8, operation => 'suffix-snapshot',
            detail => 'snapshot is closed').throw if $!closed;
        $!handle
    }

    method close(--> Nil) {
        return if $!closed;
        my $handle = $!handle;
        $!closed = True;
        $!handle = Pointer;
        my $status = ldict-suffix-snapshot-close($handle);
        ldict-suffix-snapshot-free($handle);
        check-status($status, 'suffix-snapshot-close');
    }

    method opened(--> Bool:D) { !$!closed }
    submethod DESTROY { try self.close }

    method identity(--> SuffixIdentity:D) {
        my uint64 $producer = 0;
        my uint64 $revision = 0;
        check-status(ldict-suffix-snapshot-identity(self!handle,
            $producer, $revision), 'suffix-snapshot-identity');
        SuffixIdentity.new(producer-id => $producer.UInt,
            revision => $revision.UInt)
    }

    method source-count(--> UInt:D) {
        my uint64 $count = 0;
        check-status(ldict-suffix-snapshot-source-count(self!handle, $count),
            'suffix-snapshot-source-count');
        $count.UInt
    }

    method !query(Str:D $text, Str:D $operation --> UInt:D) {
        my $buffer = $text.encode('utf8');
        my uint64 $result = 0;
        my $handle = self!handle;
        my $status = do given $operation {
            when 'contains-source' {
                ldict-suffix-snapshot-contains-source($handle,
                    raw-pointer($buffer), $buffer.elems, $result)
            }
            when 'contains-substring' {
                ldict-suffix-snapshot-contains-substring($handle,
                    raw-pointer($buffer), $buffer.elems, $result)
            }
            when 'substring-frequency' {
                ldict-suffix-snapshot-substring-frequency($handle,
                    raw-pointer($buffer), $buffer.elems, $result)
            }
        };
        check-status($status, "suffix-snapshot-{$operation}");
        $result.UInt
    }

    method contains-source(Str:D $text --> Bool:D) {
        so self!query($text, 'contains-source')
    }

    method contains-substring(Str:D $text --> Bool:D) {
        so self!query($text, 'contains-substring')
    }

    method substring-frequency(Str:D $text --> UInt:D) {
        self!query($text, 'substring-frequency')
    }

    method source-records(Int:D :$page-size = 256 --> Seq:D) {
        die 'page-size must be positive and fit a native descriptor arena'
            unless 0 < $page-size <=
                (2**(8 * nativesizeof(size_t)) - 1) div nativesizeof(SuffixSourceRecord);
        gather {
            my uint64 $offset = 0;
            loop {
                my $width = nativesizeof(SuffixSourceRecord);
                my $arena = buf8.allocate($page-size * $width);
                my size_t $written = 0;
                my uint64 $total = 0;
                my $status = ldict-suffix-snapshot-source-page(self!handle,
                    $offset, raw-pointer($arena), $page-size, $written, $total);
                last if $status == STATUS-END;
                check-status($status, 'suffix-snapshot-source-page');
                die 'native suffix page exceeded capacity or made no progress'
                    if $written > $page-size || $written == 0;
                my $base = raw-pointer($arena).Int;
                for ^$written -> $index {
                    my $raw = nativecast(SuffixSourceRecord,
                        Pointer.new($base + $index * $width));
                    my $text = buf8.allocate($raw.len);
                    memcpy(raw-pointer($text), $raw.data, $raw.len) if $raw.len;
                    take SourceRecord.new(
                        source-id => $raw.source-id.Int,
                        text => $text.decode('utf8'),
                        value => $raw.has-value ?? $raw.mapped-value.UInt !! Nil,
                    );
                }
                $offset += $written;
                last if $offset >= $total;
            }
        }
    }

    method iterator(--> Iterator:D) { self.source-records.iterator }
    method Seq(--> Seq:D) { self.source-records }
    method list(--> List:D) { self.Seq.list }
}

class SuffixIndex is export {
    has Pointer $!handle is required;
    has UnitDomain:D $.unit-domain is required;
    has Bool:D $.persistent = False;
    has PersistentRecoveryReport $.recovery-report;
    has Bool $!closed = False;

    submethod BUILD(Pointer:D :$handle!, UnitDomain:D :$unit-domain!,
        Bool:D :$persistent = False,
        PersistentRecoveryReport :$recovery-report) {
        $!handle = $handle;
        $!unit-domain = $unit-domain;
        $!persistent = $persistent;
        $!recovery-report = $recovery-report if $recovery-report.defined;
    }

    method !handle(--> Pointer:D) {
        X::Libdictenstein.new(status => 8, operation => 'suffix-index',
            detail => 'index is closed').throw if $!closed;
        $!handle
    }

    method close(--> Nil) {
        return if $!closed;
        my $handle = $!handle;
        $!closed = True;
        $!handle = Pointer;
        my $status = ldict-suffix-index-close($handle);
        ldict-suffix-index-free($handle);
        check-status($status, 'suffix-index-close');
    }

    method opened(--> Bool:D) { !$!closed }
    submethod DESTROY { try self.close }

    method insert-source(Str:D $text, Mu $value = Nil --> SuffixIndex:D) {
        my $buffer = $text.encode('utf8');
        my $optional = optional-value($value);
        check-status(ldict-suffix-index-insert-text-value(self!handle,
            raw-pointer($buffer), $buffer.elems,
            $optional.value, $optional.has-value),
            'suffix-index-insert-text');
        self
    }

    method remove-source(Str:D $text --> Bool:D) {
        my $buffer = $text.encode('utf8');
        my uint8 $removed = 0;
        check-status(ldict-suffix-index-remove-text(self!handle,
            raw-pointer($buffer), $buffer.elems, $removed),
            'suffix-index-remove-text');
        so $removed
    }

    method clear(--> SuffixIndex:D) {
        check-status(ldict-suffix-index-clear(self!handle),
            'suffix-index-clear');
        self
    }

    method compact(--> SuffixIndex:D) {
        check-status(ldict-suffix-index-compact(self!handle),
            'suffix-index-compact');
        self
    }

    method checkpoint(--> SuffixIndex:D) {
        die 'checkpoint requires a persistent suffix index' unless $!persistent;
        check-status(ldict-suffix-index-checkpoint(self!handle),
            'suffix-index-checkpoint');
        self
    }

    method checkpoint-report(--> PersistentCheckpointReport:D) {
        die 'checkpoint report requires a persistent suffix index' unless $!persistent;
        my $before-view = self.snapshot;
        my $before = $before-view.source-count.UInt;
        $before-view.close;
        my $started = now;
        self.checkpoint;
        my $elapsed = ((now - $started) * 1000).Int;
        $elapsed = 0 if $elapsed < 0;
        my $after-view = self.snapshot;
        my $after = $after-view.source-count.UInt;
        $after-view.close;
        PersistentCheckpointReport.new(
            duration-ms => $elapsed.UInt,
            visible-count-before => $before,
            visible-count-after => $after,
        )
    }

    method needs-compaction(--> Bool:D) {
        die 'maintenance state requires a persistent suffix index' unless $!persistent;
        my uint8 $needed = 0;
        check-status(ldict-suffix-index-needs-compaction(self!handle, $needed),
            'suffix-index-needs-compaction');
        so $needed
    }

    method snapshot(--> SuffixSnapshot:D) {
        my Pointer $output .= new;
        check-status(ldict-suffix-index-snapshot(self!handle, $output),
            'suffix-index-snapshot');
        die 'native suffix snapshot constructor returned null' unless $output;
        SuffixSnapshot.new(handle => $output, unit-domain => $!unit-domain)
    }
}

sub suffix-index(UnitDomain:D $domain = UNICODE-SCALAR --> SuffixIndex:D) is export {
    X::Libdictenstein.new(
        status => 6,
        operation => 'suffix-index',
        detail => 'native API revision 10 is required',
    ).throw if api-revision() < 10;
    my Pointer $output .= new;
    check-status(ldict-suffix-index-new($domain.Int, $output), 'suffix-index-new');
    die 'native suffix-index constructor returned null' unless $output;
    SuffixIndex.new(handle => $output, unit-domain => $domain)
}

sub persistent-suffix-index(IO::Path:D $path,
    PersistentSuffixFamily:D :$family = PERSISTENT-SUFFIX-AUTOMATON,
    UnitDomain:D :$domain = UNICODE-SCALAR,
    Bool:D :$create = True --> SuffixIndex:D) is export {
    X::Libdictenstein.new(
        status => 6,
        operation => 'persistent-suffix-index',
        detail => 'native API revision 12 is required',
    ).throw if api-revision() < 12;
    die 'persistent suffix sources support BYTE or UNICODE-SCALAR only'
        if $domain == U64;
    my $buffer = $path.absolute.Str.encode('utf8');
    my Pointer $output .= new;
    my Pointer $report-handle .= new;
    my $status = $create
        ?? ldict-suffix-index-persistent-create($family.Int, $domain.Int,
            raw-pointer($buffer), $buffer.elems, $output)
        !! ldict-suffix-index-persistent-open-with-recovery(
            $family.Int, $domain.Int, raw-pointer($buffer), $buffer.elems,
            $output, $report-handle);
    check-status($status, $create ?? 'persistent-suffix-create' !! 'persistent-suffix-open');
    die 'native persistent suffix constructor returned null' unless $output;
    my $transferred = False;
    LEAVE ldict-suffix-index-free($output) if $output.defined && $output && !$transferred;
    my $report = $create ?? PersistentRecoveryReport !! recovery-report-from($report-handle);
    my $index = SuffixIndex.new(handle => $output, unit-domain => $domain,
        persistent => True, recovery-report => $report);
    $transferred = True;
    $index
}

sub scdawg(UnitDomain:D $domain = UNICODE-SCALAR --> Dictionary:D) is export {
    my Pointer $output .= new;
    check-status(ldict-scdawg-new($domain.Int, $output), 'scdawg-new');
    dictionary-from($output, $domain)
}

sub double-array-trie(Mu:D $entries, UnitDomain:D :$domain = UNICODE-SCALAR
    --> Dictionary:D) is export {
    die 'DoubleArrayTrie does not support U64' if $domain == U64;
    my @pairs = pairs-from($entries);
    my @buffers;
    @buffers.push(text-buffer(.key, $domain)) for @pairs;
    my @descriptors;
    for @pairs.kv -> $index, $pair {
        my $optional = optional-value($pair.value);
        @descriptors.push(TextEntry.new(
            data => raw-pointer(@buffers[$index]),
            len => @buffers[$index].elems,
            mapped-value => $optional.value,
            has-value => $optional.has-value,
            reserved0 => 0, reserved1 => 0, reserved2 => 0, reserved3 => 0,
            reserved4 => 0, reserved5 => 0, reserved6 => 0,
        ));
    }
    my $arena = descriptor-arena(TextEntry, @descriptors);
    my Pointer $output .= new;
    check-status(ldict-double-array-trie-new($domain.Int, raw-pointer($arena),
        @pairs.elems, $output), 'double-array-trie-new');
    dictionary-from($output, $domain)
}

sub persistent-artrie(IO::Path:D $path, UnitDomain:D :$domain = UNICODE-SCALAR,
    PersistentProfile:D :$profile = PERSISTENT-DEFAULT,
    PersistentWalConfig :$wal-config,
    Bool:D :$recover = False,
    Bool:D :$create = True --> Dictionary:D) is export {
    X::Libdictenstein.new(
        status => 6,
        operation => 'persistent-artrie',
        detail => 'native API revision 11 is required',
    ).throw if api-revision() < 11;
    die 'u64 prefix-3 compatibility profile requires the U64 domain'
        if $profile == PERSISTENT-U64-PREFIX3-COMPAT && $domain != U64;
    die 'recovery is an open operation; use :!create'
        if $recover && $create;
    die 'custom WAL archive configuration is supported only for Unicode ARTries'
        if $wal-config.defined && $domain != UNICODE-SCALAR;
    my $buffer = $path.absolute.Str.encode('utf8');
    my Pointer $output .= new;
    my Pointer $report-handle .= new;
    my $status;
    if $wal-config.defined {
        my $archive = $wal-config.archive-directory.Str.encode('utf8');
        $status = $recover
            ?? ldict-persistent-artrie-char-open-with-wal-recovery(
                raw-pointer($buffer), $buffer.elems,
                ($wal-config.archive-enabled ?? 1 !! 0),
                raw-pointer($archive), $archive.elems,
                $wal-config.max-segments, $wal-config.max-archive-bytes,
                $output, $report-handle)
            !! $create
            ?? ldict-persistent-artrie-char-create-with-wal(
                raw-pointer($buffer), $buffer.elems,
                ($wal-config.archive-enabled ?? 1 !! 0),
                raw-pointer($archive), $archive.elems,
                $wal-config.max-segments, $wal-config.max-archive-bytes,
                $output)
            !! ldict-persistent-artrie-char-open-with-wal(
                raw-pointer($buffer), $buffer.elems,
                ($wal-config.archive-enabled ?? 1 !! 0),
                raw-pointer($archive), $archive.elems,
                $wal-config.max-segments, $wal-config.max-archive-bytes,
                $output);
    } else {
        $status = $recover
            ?? ldict-persistent-artrie-open-with-recovery(
                $domain.Int, $profile.Int, raw-pointer($buffer),
                $buffer.elems, $output, $report-handle)
            !! $create
            ?? ldict-persistent-artrie-create-profile($domain.Int, $profile.Int,
                raw-pointer($buffer), $buffer.elems, $output)
            !! ldict-persistent-artrie-open-profile($domain.Int, $profile.Int,
                raw-pointer($buffer), $buffer.elems, $output);
    }
    check-status($status, $create ?? 'persistent-artrie-create' !! 'persistent-artrie-open');
    $recover
        ?? dictionary-from-recovery($output, $domain, $report-handle)
        !! dictionary-from($output, $domain)
}

sub persistent-vocabulary(IO::Path:D $path, Bool:D :$recover = False,
    Bool:D :$create = True
    --> Dictionary:D) is export {
    X::Libdictenstein.new(
        status => 6,
        operation => 'persistent-vocabulary',
        detail => 'native API revision 11 is required for recovery reports',
    ).throw if $recover && api-revision() < 11;
    die 'recovery is an open operation; use :!create'
        if $recover && $create;
    my $buffer = $path.absolute.Str.encode('utf8');
    my Pointer $output .= new;
    my Pointer $report-handle .= new;
    my $status = $recover
        ?? ldict-persistent-vocab-open-with-recovery(raw-pointer($buffer),
            $buffer.elems, $output, $report-handle)
        !! $create
        ?? ldict-persistent-vocab-create(raw-pointer($buffer), $buffer.elems, $output)
        !! ldict-persistent-vocab-open(raw-pointer($buffer), $buffer.elems, $output);
    check-status($status, $create ?? 'persistent-vocab-create' !! 'persistent-vocab-open');
    $recover
        ?? dictionary-from-recovery($output, UNICODE-SCALAR, $report-handle)
        !! dictionary-from($output, UNICODE-SCALAR)
}

multi sub infix:<(|)>(Dictionary:D $left, Dictionary:D $right --> Dictionary:D)
    is export {
    $left.union($right)
}

multi sub infix:<(&)>(Dictionary:D $left, Dictionary:D $right --> Dictionary:D)
    is export {
    $left.intersection($right)
}

=begin pod

=TITLE Libdictenstein

High-performance dictionaries and trie-maps for approximate string matching.

C<Dictionary> implements C<Associative> and C<Iterable>. Constructors return
owned native handles; call C<close> deterministically, with C<DESTROY> as a
fallback. C<insert-batch> crosses the NativeCall boundary once. Algebra methods
capture immutable revisions and materialize their linear merge as an optimized
mutable DynamicDAWG.

=end pod
