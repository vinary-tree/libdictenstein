sub native-library(--> Str:D) {
    return %*ENV<LIBDICTENSTEIN_LIBRARY>
        if %*ENV<LIBDICTENSTEIN_LIBRARY>:exists;
    $*DISTRO.is-win ?? 'libdictenstein.dll' !!
        $*KERNEL.name eq 'darwin' ?? 'liblibdictenstein.dylib' !!
        'liblibdictenstein.so'
}

