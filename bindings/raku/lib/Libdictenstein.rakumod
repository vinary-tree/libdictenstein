    STATUS-PANIC => 5,
    STATUS-UNSUPPORTED => 6,
    STATUS-IO-ERROR => 7,
    STATUS-CLOSED => 8,
    STATUS-DOMAIN-MISMATCH => 9,
    STATUS-LIMIT-EXCEEDED => 10,
    STATUS-PROVIDER-ERROR => 11,
    STATUS-BATCH-IN-USE => 12,
);

our enum DictionaryKind is export (
    DYNAMIC-DAWG => 1,
    DOUBLE-ARRAY-TRIE => 2,
    SCDAWG => 3,
    PERSISTENT-ARTRIE => 4,
    PERSISTENT-VOCAB-ARTRIE => 5,
    PATHMAP => 6,
);

our enum AlgebraOperation is export (
    ALGEBRA-UNION => 1,
    ALGEBRA-INTERSECTION => 2,
    ALGEBRA-DIFFERENCE => 3,
    ALGEBRA-SYMMETRIC-DIFFERENCE => 4,
);

our enum ValueMerge is export (
    VALUE-MERGE-FIRST => 1,
    VALUE-MERGE-LAST => 2,
    VALUE-MERGE-LATTICE-JOIN => 3,
    VALUE-MERGE-LATTICE-MEET => 4,
);

our constant PERSISTENT-VOCABULARY is export = PERSISTENT-VOCAB-ARTRIE;

our constant CAP-READ is export = 1 +< 0;
our constant CAP-INSERT is export = 1 +< 1;
our constant CAP-REMOVE is export = 1 +< 2;
our constant CAP-CLEAR is export = 1 +< 3;
our constant CAP-COMPACT is export = 1 +< 4;
our constant CAP-SUBSTRING is export = 1 +< 5;
our constant CAP-CHECKPOINT is export = 1 +< 6;
# END GENERATED RAKU ABI CONSTANTS

our enum PersistentProfile is export (
    PERSISTENT-DEFAULT => 0,
    PERSISTENT-U64-PREFIX3-COMPAT => 1,
);

our enum PersistentSuffixFamily is export (
    PERSISTENT-SUFFIX-AUTOMATON => 1,
    PERSISTENT-SUFFIX-TREE => 2,
    PERSISTENT-SCDAWG => 3,
);

class PersistentWalConfig is export {
    has Bool:D $.archive-enabled = True;
    has IO::Path:D $.archive-directory = IO::Path.new('wal_archive');
    has UInt:D $.max-segments = 10;
    has UInt:D $.max-archive-bytes = 10 * 1024 * 1024 * 1024;

    submethod TWEAK() {
        die 'WAL max-segments must be positive and fit size_t'
            if $!max-segments == 0 ||
                $!max-segments > 2 ** (8 * nativesizeof(Pointer)) - 1;
        die 'WAL max-archive-bytes must be positive and fit uint64'
            if $!max-archive-bytes == 0 || $!max-archive-bytes > 2 ** 64 - 1;
    }
}

our enum RecoveryMode is export (
    RECOVERY-NORMAL => 0,
    RECOVERY-REBUILD-FROM-WAL => 1,
    RECOVERY-REPAIR-IN-PLACE => 2,
    RECOVERY-CREATED-NEW => 3,
);

class PersistentRecoveryReport is export {
    has RecoveryMode:D $.mode is required;
    has UInt:D $.records-replayed is required;
    has UInt:D $.terms-recovered is required;
    has UInt:D $.duration-ms is required;
    has IO::Path $.corrupted-file;
    has Str $.corruption-reason;
    has @.archive-segments;
}

class PersistentCheckpointReport is export {
    has UInt:D $.duration-ms is required;
    has UInt:D $.visible-count-before is required;
    has UInt:D $.visible-count-after is required;
}

class X::Libdictenstein is Exception {
    has Int:D $.status is required;
    has Str:D $.operation is required;
    has Str:D $.detail = '';

    method message(--> Str:D) {
        my $base = "libdictenstein operation '$!operation' failed with status $!status";
        $!detail.chars ?? "$base: $!detail" !! $base
    }
}

