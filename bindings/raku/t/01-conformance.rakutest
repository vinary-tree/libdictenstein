use Test;
use NativeCall;
use Libdictenstein;

is abi-version, ABI-VERSION, 'ABI version matches the package contract';
is api-revision, API-REVISION, 'API revision includes typed suffix index and PathMap constructor';
is +STATUS-OK, 0, 'generated status enum agrees with the C header';
is +STATUS-BATCH-IN-USE, 12, 'generated status enum includes cursor lease errors';
is PERSISTENT-VOCABULARY, PERSISTENT-VOCAB-ARTRIE,
    'existing vocabulary alias preserves the generated backend kind';
is nativesizeof(OptionalValue), 16, 'optional u64 layout matches C';
is nativesizeof(TextEntry), 32, 'text descriptor layout matches C';
is nativesizeof(U64Entry), 32, 'u64 descriptor layout matches C';
is nativesizeof(SuffixSourceRecord),
    8 + 2 * nativesizeof(Pointer) + nativesizeof(OptionalValue),
    'typed suffix record descriptor layout matches C';

subtest 'revision-8 PathMap and typed suffix source index' => {
    my $bytes = pathmap(BYTE);
    is $bytes.kind, PATHMAP, 'PathMap reports its distinct backend kind';
    my $raw = Buf.new(0x00, 0xff, 0x80);
    $bytes.ASSIGN-KEY($raw, 0);
    is $bytes.AT-KEY($raw), 0, 'PathMap preserves non-UTF-8 byte keys and zero values';
    is $bytes.insert-batch([Pair.new(Buf.new(0xff), Nil)]), 1,
        'PathMap batches arbitrary byte keys';
    $bytes.close;
    my $unicode = pathmap;
    $unicode.ASSIGN-KEY('é🙂', 7);
    is $unicode.AT-KEY('é🙂'), 7, 'Unicode PathMap follows scalar domain';
    $unicode.close;
    dies-ok { pathmap(U64) }, 'PathMap rejects the unsupported token domain';
    my $index = suffix-index;
    $index.insert-source('banana', 0);
    my $view = $index.snapshot;
    ok $view.contains-source('banana'), 'suffix source membership is typed';
    is $view.substring-frequency('ana'), 2,
        'suffix index counts overlapping occurrences';
    $index.close;
    is $view.source-count, 1, 'suffix snapshot survives its producer';
    $view.close;
};

subtest 'Unicode Associative and snapshot Iterable' => {
    my $dictionary = dynamic-dawg;
    is $dictionary.elems, 0, 'new dictionary is empty';
    is $dictionary.ASSIGN-KEY('cat', 7), 7, 'assign returns its value';
    $dictionary.ASSIGN-KEY('cot', Nil);
    $dictionary.ASSIGN-KEY('zero', 0);
    ok $dictionary.EXISTS-KEY('cot'), 'valueless term is present';
    is $dictionary.AT-KEY('cat'), 7, 'mapped value round-trips';
    is $dictionary.AT-KEY('zero'), 0, 'zero is not confused with valueless';
    ok !$dictionary.EXISTS-KEY('missing'), 'absent key is absent';
    is $dictionary.elems, 3, 'collection length is native';
    is-deeply $dictionary.list.map(*.key).sort.Array,
        <cat cot zero>.Array, 'iteration is lexicographic and complete';
    my $early = $dictionary.iterator;
    ok $early.pull-one ~~ Pair, 'explicit iterator yields one snapshot entry';
    lives-ok { $early.close }, 'explicit iterator closes deterministically after early stop';

    my $snapshot = $dictionary.snapshot;
    $dictionary.DELETE-KEY('cat');
    ok $snapshot.EXISTS-KEY('cat'), 'captured revision survives live deletion';
    $snapshot.close;

    is $dictionary.insert-batch([
        ant => 1,
        bee => Nil,
        eel => 3,
    ]), 3, 'batch insertion crosses once and reports new terms';
    is $dictionary.kind, DYNAMIC-DAWG, 'backend kind is modeled';
    ok $dictionary.capabilities +& CAP-INSERT, 'capability bitset exposes mutation';
    lives-ok { $dictionary.compact }, 'DynamicDAWG compaction is exposed';
    $dictionary.close;
    ok !$dictionary.opened, 'close is deterministic';
    dies-ok { $dictionary.elems }, 'closed handles reject access';
};

subtest 'byte and u64 domains' => {
    my $bytes = dynamic-dawg(BYTE);
    my $tokens = dynamic-dawg(U64);
    my $raw = Buf.new(0x00, 0xff, 0x41);
    $bytes.ASSIGN-KEY($raw, 5);
    is $bytes.AT-KEY($raw), 5, 'arbitrary byte key round-trips';
    my @sequence = 1, 2, 2**64 - 1;
    $tokens.ASSIGN-KEY(@sequence, Nil);
    ok $tokens.EXISTS-KEY(@sequence), 'u64-token key is present';
    ok !$tokens.AT-KEY(@sequence).defined, 'u64 valueless mapping stays valueless';
    is $tokens.insert-batch([
        Pair.new([4, 5, 6], 9),
        Pair.new([7, 8], Nil),
    ]), 2, 'u64 descriptor arena inserts multi-token keys in one crossing';
    is $tokens.AT-KEY([4, 5, 6]), 9,
        'batched u64 mapped value round-trips';
    ok $tokens.EXISTS-KEY([7, 8]),
        'batched u64 valueless member remains present';
    $bytes.close;
    $tokens.close;
};

subtest 'immutable and suffix backends' => {
    my $dat = double-array-trie([cat => 1, dog => Nil]);
    is $dat.AT-KEY('cat'), 1, 'DoubleArrayTrie exposes exact lookup';
    dies-ok { $dat.ASSIGN-KEY('new', 2) }, 'DoubleArrayTrie rejects mutation';
    my $suffix = scdawg;
    $suffix.ASSIGN-KEY('banana', 3);
    $suffix.ASSIGN-KEY('bandana', Nil);
    ok $suffix.contains-substring('ana'), 'SCDAWG exposes substring membership';
    ok $suffix.substring-frequency('ana') >= 2,
        'SCDAWG exposes substring frequency';
    $dat.close;
    $suffix.close;
};

subtest 'native algebra and optional-value lattices' => {
    my $left = dynamic-dawg;
    my $right = dynamic-dawg;
    $left.insert-batch([left => 1, shared => 4, valueless => Nil]);
    $right.insert-batch([right => 2, shared => 9, valueless => 7]);

    my $joined = $left.union($right, merge => VALUE-MERGE-LATTICE-JOIN);
    my $met = $left.intersection($right);
    my $only-left = $left.difference($right);
    my $exclusive = $left.symmetric-difference($right);
    is $joined.AT-KEY('shared'), 9, 'lattice join takes numeric maximum';
    is $joined.AT-KEY('valueless'), 7, 'optional join preserves present value';
    is $met.AT-KEY('shared'), 4, 'default intersection takes lattice meet';
    ok !$met.AT-KEY('valueless').defined,
        'optional meet is valueless unless both values exist';
    is-deeply $only-left.list.map(*.key).Array, ['left'],
        'difference retains left-only keys';
    is-deeply $exclusive.list.map(*.key).sort.Array, <left right>.Array,
        'symmetric difference retains exclusive keys';

    $left.ASSIGN-KEY('later', 99);
    ok !$joined.EXISTS-KEY('later'), 'result owns an independent snapshot';
    $joined.ASSIGN-KEY('result-only', 10);
    ok !$left.EXISTS-KEY('result-only'), 'result remains independently mutable';
    .close for $joined, $met, $only-left, $exclusive, $left, $right;
};

subtest 'persistent checkpoint and reopen' => {
    my $scratch = IO::Path.new(
        %*ENV<LIBDICTENSTEIN_TEST_SCRATCH> // $*CWD.add('target/raku-test'));
    $scratch.mkdir;
    my $path = $scratch.add("persistent-{$*PID}-{now.Int}");
    my $created = persistent-artrie($path, :create);
    $created.ASSIGN-KEY('durable', 41);
    $created.checkpoint;
    $created.close;
    my $reopened = persistent-artrie($path, :!create);
    is $reopened.AT-KEY('durable'), 41, 'checkpoint survives reopen';
    $reopened.close;
};

subtest 'persistent u64 prefix-3 compatibility profile' => {
    my $scratch = IO::Path.new(
        %*ENV<LIBDICTENSTEIN_TEST_SCRATCH> // $*CWD.add('target/raku-test'));
    $scratch.mkdir;
    my $path = $scratch.add("persistent-prefix3-{$*PID}-{now.Int}");
    dies-ok {
        persistent-artrie($path, :domain(BYTE),
            :profile(PERSISTENT-U64-PREFIX3-COMPAT))
    }, 'u64 profile is rejected for byte keys';
    my $created = persistent-artrie($path, :domain(U64),
        :profile(PERSISTENT-U64-PREFIX3-COMPAT));
    $created.ASSIGN-KEY([0, 18446744073709551615], 0);
    $created.checkpoint;
    $created.close;
    my $reopened = persistent-artrie($path, :domain(U64),
        :profile(PERSISTENT-U64-PREFIX3-COMPAT), :!create);
    is $reopened.AT-KEY([0, 18446744073709551615]), 0,
        'prefix-3 u64 values survive checkpoint and reopen';
    $reopened.close;
    my $recovered = persistent-artrie($path, :domain(U64),
        :profile(PERSISTENT-U64-PREFIX3-COMPAT), :!create, :recover);
    is $recovered.recovery-report.mode, RECOVERY-NORMAL,
        'u64 recovery reports a clean checkpoint';
    is $recovered.recovery-report.archive-segments.elems, 0,
        'recovery report owns an empty archive-segment list';
    $recovered.close;
};

subtest 'Unicode persistent WAL archive policy' => {
    my $scratch = IO::Path.new(
        %*ENV<LIBDICTENSTEIN_TEST_SCRATCH> // $*CWD.add('target/raku-test'));
    $scratch.mkdir;
    my $path = $scratch.add("persistent-wal-{$*PID}-{now.Int}");
    my $wal = PersistentWalConfig.new(
        archive-directory => IO::Path.new("wal-archive-{$*PID}-{now.Int}"),
        max-segments => 2,
        max-archive-bytes => 1024 * 1024,
    );
    dies-ok { PersistentWalConfig.new(max-segments => 0) },
        'zero WAL segment limit is rejected before the native call';
    dies-ok { persistent-artrie($path, :domain(BYTE), wal-config => $wal) },
        'byte ARTrie rejects Unicode-only custom WAL policy';
    my $created = persistent-artrie($path, wal-config => $wal);
    $created.ASSIGN-KEY('durable🙂', 17);
    my $checkpoint = $created.checkpoint-report;
    is $checkpoint.visible-count-before, 1,
        'checkpoint report samples one visible term before persistence';
    is $checkpoint.visible-count-after, 1,
        'checkpoint report samples one visible term afterward';
    $created.close;
    my $reopened = persistent-artrie($path, wal-config => $wal, :!create);
    is $reopened.AT-KEY('durable🙂'), 17,
        'custom WAL policy preserves Unicode values across checkpoint and reopen';
    $reopened.close;
    my $recovered = persistent-artrie($path, wal-config => $wal,
        :!create, :recover);
    is $recovered.AT-KEY('durable🙂'), 17,
        'configured recovery preserves the Unicode mapping';
    ok $recovered.recovery-report ~~ PersistentRecoveryReport,
        'configured recovery exposes the complete typed report';
    $recovered.close;
};

subtest 'persistent vocabulary recovery report' => {
    my $scratch = IO::Path.new(
        %*ENV<LIBDICTENSTEIN_TEST_SCRATCH> // $*CWD.add('target/raku-test'));
    $scratch.mkdir;
    my $path = $scratch.add("persistent-vocab-recovery-{$*PID}-{now.Int}");
    my $vocab = persistent-vocabulary($path, :!create, :recover);
    is $vocab.recovery-report.mode, RECOVERY-CREATED-NEW,
        'missing vocabulary is created with an explicit recovery report';
    is $vocab.vocabulary-insert('alpha'), 0,
        'vocabulary auto-assignment returns the stable native index';
    is $vocab.vocabulary-insert('alpha'), 0,
        'repeated term keeps its index';
    is-deeply $vocab.vocabulary-insert-batch(['β', 'alpha', 'gamma']),
        (1, 0, 2).List, 'ordered vocabulary batch returns assigned indices';
    is $vocab.vocabulary-term(2), 'gamma',
        'reverse vocabulary lookup follows batch insertion';
    $vocab.close;
};

subtest 'six native persistent suffix variants and retained source revisions' => {
    my $scratch = IO::Path.new(
        %*ENV<LIBDICTENSTEIN_TEST_SCRATCH> // $*CWD.add('target/raku-test'));
    $scratch.mkdir;
    for (PERSISTENT-SUFFIX-AUTOMATON, PERSISTENT-SUFFIX-TREE,
         PERSISTENT-SCDAWG) -> $family {
        for (BYTE, UNICODE-SCALAR) -> $domain {
            my $path = $scratch.add(
                "persistent-suffix-{$family.Int}-{$domain.Int}-{$*PID}-{now.Int}");
            my $index = persistent-suffix-index($path, :$family, :$domain);
            ok $index.persistent, "family {$family.Int} domain {$domain.Int} is persistent";
            $index.insert-source('banana', 0);
            $index.insert-source('banané', 7);
            my $old = $index.snapshot;
            is $old.source-count, 2, 'native view captures both source records';
            ok $index.remove-source('banana'), 'source removal succeeds';
            ok $old.contains-source('banana'), 'old native view retains removed source';
            my $fresh = $index.snapshot;
            nok $fresh.contains-source('banana'), 'new view excludes removed source';
            $fresh.close;
            $index.compact;
            my $checkpoint = $index.checkpoint-report;
            is $checkpoint.visible-count-after, 1,
                'suffix checkpoint report samples the remaining record';
            $index.close;
            ok $old.contains-source('banana'), 'view survives persistent index close';
            $old.close;
            my $reopened = persistent-suffix-index($path, :$family, :$domain, :!create);
            ok $reopened.recovery-report ~~ PersistentRecoveryReport,
                'reopen exposes a typed native recovery report';
            my $view = $reopened.snapshot;
            nok $view.contains-source('banana'), 'removed source stays absent after reopen';
            ok $view.contains-source('banané'), 'remaining source survives checkpoint';
            is $view.source-records.list[0].value, 7,
                'mapped value survives persistent suffix reopen';
            $view.close;
            $reopened.close;
        }
    }
    dies-ok { persistent-suffix-index($scratch.add('u64-invalid'), :domain(U64)) },
        'u64 token sources are inapplicable to persistent suffix families';
};

done-testing;
