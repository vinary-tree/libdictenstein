;; ===========================================================================
;; Persistent ARTrie NodeHeader — the 16-byte fixed prefix on every ART node.
;; Source of truth: src/persistent_artrie/nodes/mod.rs (struct NodeHeader).
;; Color key: green = node identity · amber = mutable counters/flags ·
;;            grey = alignment padding · blue = optimistic-lock version
;; ===========================================================================
(defattrs :ident {:fill "#C8E6C9"})
(defattrs :flag  {:fill "#FFE0B2"})
(defattrs :pad   {:fill "#ECEFF1"})
(defattrs :ver   {:fill "#BBDEFB"})

(def boxes-per-row 8)
(def left-margin 1)

(draw-column-headers)

(draw-box "node_type" [:ident])
(draw-box "prefix_len" [:ident])
(draw-box "flags" [:flag])
(draw-box "_pad" [:pad])
(draw-box "num_children" [{:span 2} :flag])
(draw-box "_pad2" [{:span 2} :pad])
(draw-box "version  —  u64 optimistic-lock counter" [{:span 8} :ver])
