// ============================================================================
// f4-lock-hierarchy.dot — the F4 "lock collapse" strict acyclic lock ordering.
// After F4, SharedARTrie / SharedCharARTrie / SharedVocabARTrie are bare Arc<T>:
// overlay reads AND writes are lock-free. The ONLY residual locks — for concurrent
// checkpoints, byte/char merges, and eviction — obey one strict acyclic
// order: CK > merge_lock > EC. Acquire only top→bottom; EC is a LEAF never
// held across another lock or a worker .join() (the drop-before-join discipline).
// (The former inner owned_root "OR" RwLock rung was removed once the lock-free
// overlay became the sole production structure.)
//
// Source of truth: src/persistent_artrie/core/shared_access.rs (module header).
// Verified by tests/persistent_lockfree_f4_lock_hierarchy_loom.rs and
// tests/vocab_lockfree_f4_lock_hierarchy_loom.rs.
//
// Color key (house palette + persistence accents — docs/diagrams/README.md):
//   red    #FFCDD2  lock / serialization rung (deeper red border = higher in the order)
//   teal   #B2DFDB  the lock-free overlay (reads AND writes — NO lock)
//   grey   #ECEFF1  the vocab subset boundary (CK, EC only — no merge_lock)
//   dark slate #37474F  the "acquired-before" ordering edges
// ============================================================================
digraph f4_lock_hierarchy {
    rankdir=TB;
    bgcolor="#FFFFFF";
    fontname="DejaVu Sans";
    labelloc="t";
    fontsize=15;
    fontcolor="#212121";
    label="F4 lock hierarchy — strict acyclic order CK > merge_lock > EC\n(the handle is lock-free; locks serialize ONLY\ncheckpoint · merge · eviction)";
    nodesep=0.5;
    ranksep=0.7;
    node [shape=box, style="filled,rounded", fontname="DejaVu Sans",
          fontcolor="#212121", penwidth=1.8, margin="0.22,0.13"];
    edge [color="#37474F", fontname="DejaVu Sans", fontcolor="#37474F", penwidth=1.8];

    // --- the lock-free overlay (no lock) --------------------------------
    overlay [label="Lock-free overlay (reads AND writes)\nbare Arc<T> · CAS root · NO lock",
             fillcolor="#B2DFDB", color="#00695C"];

    // --- the three lock rungs (top = acquired first) --------------------
    CK [label="CK — checkpoint_lock : Mutex<()>\nserialize concurrent checkpoints",
        fillcolor="#FFCDD2", color="#B71C1C"];
    ML [label="merge_lock : Mutex<()>\nserialize merge vs merge  (byte/char only)",
        fillcolor="#FFCDD2", color="#C62828"];
    EC [label="EC — eviction_coordinator : Mutex<Option<..>>\nLEAF — never held across a lock\nor a worker .join()",
        fillcolor="#FFCDD2", color="#E53935"];

    // --- ordering edges (acquire only top → bottom) ---------------------
    overlay -> CK [label="mutators are &self;\nonly these take a lock", style="dashed", color="#00695C", fontcolor="#00695C"];
    CK -> ML [label="acquired-before"];
    ML -> EC [label="acquired-before"];

    // --- the vocab subset: CK and EC only (no merge_lock / OR) ----------
    subgraph cluster_vocab {
        label="vocab subset — overlay-only, so CK, EC only\n(CK, EC independent: the vocab eviction\ncallback is a no-op, so CK never reads EC\n— trivially acyclic)";
        style="dashed,rounded";
        color="#607D8B";
        fontcolor="#455A64";
        fontsize=11;
        bgcolor="#F5F5F5";
        CKv [label="CK — checkpoint_lock", fillcolor="#FFCDD2", color="#B71C1C"];
        ECv [label="EC — eviction_coordinator (no-op callback)", fillcolor="#FFCDD2", color="#E53935"];
        CKv -> ECv [style="invis"];
    }

    // --- stack the three components vertically so the graph is a narrow column
    EC -> CKv [style="invis"];
    ECv -> legend [style="invis"];

    // --- rendered legend ------------------------------------------------
    legend [shape=note, style="filled", fillcolor="#FFF9C4", color="#FBC02D",
            fontsize=10, fontcolor="#212121",
            label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1">
<TR><TD ALIGN="LEFT"><B>Legend</B></TD></TR>
<TR><TD ALIGN="LEFT"><FONT COLOR="#00695C">teal = lock-free overlay (no lock on read or write)</FONT></TD></TR>
<TR><TD ALIGN="LEFT"><FONT COLOR="#C62828">red = a residual lock rung (acquire top→bottom only)</FONT></TD></TR>
<TR><TD ALIGN="LEFT">EC is a LEAF — drop-before-join:</TD></TR>
<TR><TD ALIGN="LEFT">`let x = f.lock().take(); x.shutdown();`</TD></TR>
<TR><TD ALIGN="LEFT"><FONT COLOR="#607D8B">grey dashed = vocab's smaller CK/EC-only order</FONT></TD></TR>
</TABLE>>];
}
