@startuml art-node16-fields
' ============================================================================
' art-node16-fields.puml — the Node16 struct layout (byte-ART, 5..16 children).
' Source: docs/theory/disk-tries/03-adaptive-radix-tree.md (Leis et al. 2013).
' Replaces the ASCII struct-field box with a compact, colored, viewBox'd byte-field.
' Color key:  green identity · amber child-count · light-blue inline prefix ·
'             blue sorted keys · mid-blue child pointers
' ============================================================================
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam rectangle {
  BorderColor #37474F
  FontColor #212121
  BorderThickness 1.2
}
skinparam TitleFontSize 15

title Node16 — 5..16 children (~160 B) · SSE 16-way SIMD compare

rectangle "**type** : u8 — node-type tag (= 16)" as R0 #C8E6C9
rectangle "**num_children** : u8 — child count (5..16)" as R1 #FFE0B2
rectangle "**partial_len** : u8 — compressed-path length" as R2 #C8E6C9
rectangle "**partial** : [u8; 8] — inline compressed prefix" as R3 #E3F2FD
rectangle "**keys** : [u8; 16] — sorted key bytes (16-aligned)" as R4 #BBDEFB
rectangle "**children** : [ptr; 16] — child pointers" as R5 #90CAF9

R0 -[hidden]down- R1
R1 -[hidden]down- R2
R2 -[hidden]down- R3
R3 -[hidden]down- R4
R4 -[hidden]down- R5

legend bottom
  green identity · amber child-count · light-blue inline prefix
  blue sorted keys · mid-blue child pointers
endlegend
@enduml
