@startuml art-node16-fields
' ============================================================================
' art-node16-fields.puml — the Node16 struct layout (byte-ART, 5..16 children).
' Source of truth: src/persistent_artrie/nodes/node16.rs (§Layout comment, ~168 B).
' Drawn as a CONTIGUOUS colored field table hosted in a floating note; rows share
' borders (no gaps). Layout = 16-B NodeHeader + 12-B CompressedPrefix + keys + children.
' Color key: green NodeHeader · light-blue inline prefix · blue sorted keys ·
'            mid-blue child pointers
' ============================================================================
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam TitleFontSize 15
skinparam noteFontSize 14
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #37474F
}

title Node16 — 5..16 children (~168 B) · SSE 16-way SIMD compare

note as N16
|= field |= description |
|<#C8E6C9> NodeHeader : 16 B |<#C8E6C9> fixed 16-byte prefix — see node-header |
|<#E3F2FD> prefix : [u8; 12] |<#E3F2FD> inline compressed path (CompressedPrefix) |
|<#BBDEFB> keys : [u8; 16] |<#BBDEFB> sorted key bytes · SSE4.1 SIMD compare |
|<#90CAF9> children : [SwizzledPtr; 16] |<#90CAF9> child pointers (128 B) |
end note

legend bottom
| Color | Field |
|<#C8E6C9>| NodeHeader — 16 B fixed prefix (see node-header) |
|<#E3F2FD>| inline compressed-path prefix (12 B) |
|<#BBDEFB>| sorted routing keys |
|<#90CAF9>| child pointers (SwizzledPtr, 8 B each) |
endlegend
@enduml
