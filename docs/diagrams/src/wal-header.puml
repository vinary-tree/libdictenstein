@startuml wal-header
' ============================================================================
' wal-header.puml — the 64-byte WAL file header (29 bytes used, 35 reserved).
' Source of truth: src/persistent_artrie/core/wal/header.rs (WalHeader, SIZE=64).
' Drawn as a CONTIGUOUS colored byte table (offset column + field column, one row
' per field) hosted in a floating note; rows share borders (no gaps). Full-cell
' color via Creole |<#hex>| cells.
' NOTE: a literal '|' is the Creole column separator — magic/rank_regime use '·'.
' Color key: green identity/version · indigo checkpoint LSN · orange commit-seq ·
'            amber regime flag · grey reserved
' ============================================================================
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam TitleFontSize 15
skinparam noteFontSize 14
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #37474F
}

title WAL file header — 64 bytes (records begin at offset 64)

note as WH
|= bytes |= field |
|<#C8E6C9> 0..7 |<#C8E6C9> magic = 'PARTWAL'+NUL  ·  'PARTWALO' (overlay) |
|<#C8E6C9> 8..11 |<#C8E6C9> version = 2  (min supported = 1) |
|<#C5CAE9> 12..19 |<#C5CAE9> checkpoint_lsn  = committed watermark |
|<#FFCC80> 20..27 |<#FFCC80> commit_seq_floor  (carried across rotation) |
|<#FFE0B2> 28 |<#FFE0B2> rank_regime  (Owned = 0 · Overlay = 1) |
|<#ECEFF1> 29..63 |<#ECEFF1> reserved  (zero-filled; additive future fields) |
end note

legend bottom
| Color | Field |
|<#C8E6C9>| identity — magic · version |
|<#C5CAE9>| checkpoint LSN (committed watermark) |
|<#FFCC80>| commit-seq floor (WAL) |
|<#FFE0B2>| rank-regime flag |
|<#ECEFF1>| reserved |
endlegend
@enduml
