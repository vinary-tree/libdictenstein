@startuml wal-header
' ============================================================================
' wal-header.puml — the 64-byte WAL file header (29 bytes used, 35 reserved).
' Source of truth: src/persistent_artrie/core/wal/header.rs (WalHeader, SIZE=64).
' Replaces the no-viewBox svgbob SVG with a compact, colored, viewBox'd byte-field.
' Color key: green identity/magic · green version · indigo checkpoint LSN ·
'            orange commit-seq (WAL) · amber regime flag · grey reserved
' ============================================================================
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam rectangle {
  BorderColor #37474F
  FontColor #212121
  BorderThickness 1.2
}
skinparam TitleFontSize 15

title WAL file header — 64 bytes (records begin at offset 64)

rectangle "bytes **0..7**    magic = 'PARTWAL' + NUL  |  'PARTWALO'" as R0 #C8E6C9
rectangle "bytes **8..11**    version = 2  (min supported = 1)" as R1 #C8E6C9
rectangle "bytes **12..19**    checkpoint_lsn  = committed watermark" as R2 #C5CAE9
rectangle "bytes **20..27**    commit_seq_floor  (carried across rotation)" as R3 #FFCC80
rectangle "byte  **28**    rank_regime  (Owned = 0 | Overlay = 1)" as R4 #FFE0B2
rectangle "bytes **29..63**    reserved  (zero-filled; additive future fields)" as R5 #ECEFF1

R0 -[hidden]down- R1
R1 -[hidden]down- R2
R2 -[hidden]down- R3
R3 -[hidden]down- R4
R4 -[hidden]down- R5

legend bottom
  green identity/version · indigo checkpoint LSN · orange commit-seq
  amber regime · grey reserved
endlegend
@enduml
