@startuml art-node4-fields
' ============================================================================
' art-node4-fields.puml — the Node4 struct layout (byte-ART, 1..4 children).
' Source of truth: src/persistent_artrie/nodes/node4.rs (§Layout comment).
' Drawn as a CONTIGUOUS colored field table hosted in a floating note; rows share
' borders (no gaps). Full-cell color via Creole |<#hex>| cells.
' Layout = 16-B NodeHeader (see node-header) + 12-B CompressedPrefix + keys + children.
' Color key:  green   #C8E6C9  the fixed NodeHeader (identity + counters + version)
'             l-blue  #E3F2FD  inline compressed-path prefix (CompressedPrefix)
'             blue    #BBDEFB  routing keys
'             mid-blue #90CAF9 child pointers (SwizzledPtr, 8 B each)
' ============================================================================
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam TitleFontSize 15
skinparam noteFontSize 14
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #37474F
}

title Node4 — 1..4 children (~64 B) · linear scan

note as N4
|= field |= description |
|<#C8E6C9> NodeHeader : 16 B |<#C8E6C9> fixed 16-byte prefix — see node-header |
|<#E3F2FD> prefix : [u8; 12] |<#E3F2FD> inline compressed path (CompressedPrefix) |
|<#BBDEFB> keys : [u8; 4] |<#BBDEFB> sorted key bytes · linear scan |
|<#90CAF9> children : [SwizzledPtr; 4] |<#90CAF9> child pointers (32 B) |
end note

legend bottom
| Color | Field |
|<#C8E6C9>| NodeHeader — 16 B fixed prefix (see node-header) |
|<#E3F2FD>| inline compressed-path prefix (12 B) |
|<#BBDEFB>| routing keys |
|<#90CAF9>| child pointers (SwizzledPtr, 8 B each) |
endlegend
@enduml
