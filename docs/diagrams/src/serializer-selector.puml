@startuml serializer-selector
' Binary-only serializer selection.
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam ArrowColor #37474F
skinparam packageStyle rectangle
skinparam rectangle {
  BorderColor #37474F
  FontColor #212121
  BorderThickness 1.1
}
skinparam TitleFontSize 15

title Choosing a compact binary serializer

rectangle "Must a non-Rust consumer\nread the dictionary?" as Q #FFE0B2

rectangle "No\n**BincodeSerializer**\ncompact Rust-native bytes" as B #C8E6C9
rectangle "Yes\n**ProtobufSerializer**\nportable numbered schema" as P #C8E6C9

rectangle "Do mapped values\nneed to survive?" as V #E3F2FD
rectangle "Byte backend\n**serialize_with_values**" as BV #BBDEFB
rectangle "Unicode backend\n**serialize_with_values_char**" as CV #BBDEFB

rectangle "Optional transport wrapper\n**GzipSerializer<S>**\nbenchmark corpus-dependent trade-off" as G #F0F4C3

Q --> B : no
Q --> P : yes
B --> V : mapped bincode
V --> BV : Unit = u8
V --> CV : Unit = char
B --> G : optional
P --> G : optional

note bottom of G
  JSON, TOML, and newline text are not
  dictionary persistence formats.
end note
@enduml
