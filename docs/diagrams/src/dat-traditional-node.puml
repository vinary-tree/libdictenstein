@startuml dat-traditional-node
' ============================================================================
' dat-traditional-node.puml — the pointer-based trie node DAT replaces.
' Replaces the ASCII node record in docs/algorithms/implementations/double-array-trie.md.
' Color key:  red = the costly traditional node (high overhead, pointer chasing).
' ============================================================================
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam ArrowColor #37474F
skinparam rectangle {
  BorderColor #37474F
  FontColor #212121
  BorderThickness 1.2
}
skinparam noteFontSize 13
skinparam TitleFontSize 15

title Traditional trie node (32–64 bytes)

rectangle "**is_final**\n1 byte" as F #FFCDD2
rectangle "**children: HashMap / Vec**\n24–56 bytes · pointer-chased" as C #FFCDD2
F -[hidden]right- C

note bottom
  Problems: high per-node overhead · pointer chasing (cache misses) ·
  unpredictable memory-access patterns
end note
@enduml
