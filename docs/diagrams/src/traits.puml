@startuml traits
' ============================================================================
' libdictenstein trait layer (part 1 of 2) — READ API + unit/value bounds.
' Split from the former single 12-interface diagram (too wide for the prose
' column); the mutation + persistent traits live in traits-2.puml.
' Source of truth: src/lib.rs (Dictionary, DictionaryNode, MappedDictionary),
' src/bijective.rs (BijectiveDictionary), src/char_unit.rs (CharUnit),
' src/value.rs (DictionaryValue).
' Color key:  green = read traits   grey = unit / value bounds
' ============================================================================
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam shadowing false
skinparam nodesep 14
skinparam ranksep 34
skinparam ArrowColor #37474F
skinparam classBorderColor #37474F
skinparam classFontStyle bold
skinparam classAttributeFontStyle plain

title libdictenstein trait layer — read API + bounds (1 of 2)

interface Dictionary <<read>> #C8E6C9 {
  Node : DictionaryNode
  +root() : Node
  +contains(term)
  +len()
}
interface DictionaryNode <<read>> #C8E6C9 {
  Unit : CharUnit
  +is_final()
  +transition(Unit)
  +edges()
}
interface MappedDictionary <<read>> #C8E6C9 {
  Value : DictionaryValue
  +get_value(term)
  +contains_with_value(…)
}
interface BijectiveDictionary <<read>> #C8E6C9 {
  +get_term(id) : Cow<str>
  +get_id(term) : u64
}
interface CharUnit <<unit>> #ECEFF1 {
  u8 | char | u64
}
interface DictionaryValue <<value>> #ECEFF1 {
  Clone+Default+Send+Sync
}

' --- supertrait (inheritance) + associated-type edges ---
Dictionary <|-- MappedDictionary
MappedDictionary <|-- BijectiveDictionary
Dictionary ..> DictionaryNode : "Node ="
DictionaryNode ..> CharUnit : "Unit ="
MappedDictionary ..> DictionaryValue : "Value ="

note bottom of BijectiveDictionary
  Mutation + persistent traits
  (Mutable*, ARTrie, KeyEncoding)
  are in traits-2.
end note

legend right
| Color | Trait family |
|<#C8E6C9>| read (query / traverse) |
|<#ECEFF1>| unit / value bounds |
endlegend
@enduml
