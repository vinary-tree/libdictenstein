# =============================================================================
# proof-artifact-map.d2 — PART ① of the two-pronged formal-verification strategy:
# the TLA⁺/TLC MODEL-CHECKING prong plus the shared implementation-under-test and
# correspondence harness that both prongs tie to. TLA⁺/TLC model-checks bounded
# concurrency + crash interleavings (temporal safety/liveness). The Rocq
# THEOREM-PROVING prong (functional correctness + ADT refinement, ∀ inputs, Qed.,
# 0 Admitted/Axiom) is the companion figure proof-artifact-map-2.d2.
# Grounded in formal-verification/README.md + VERIFICATION_RESULTS.md.
# Split from the original single figure (was 1615px) so each part fits the prose
# column; the same technique as architecture→architecture-2 / kernel-substrate→-2.
#
# Color key (house palette): purple/blue model-checked (TLA⁺) · orange (amber)
#            correspondence harness · slate/grey implementation under test.
#            (green theorem-proved (Rocq) lives in the companion figure.)
# =============================================================================

vars: { d2-config: { layout-engine: elk } }
direction: down

title: |md
  # Proof-artifact map ① — model checking

  *TLA⁺ / TLC prong · ties to impl + harness*
| { near: top-center; style.font-size: 16; style.font-color: "#212121" }

tla: "① TLA⁺ / TLC — model checking" {
  style: { fill: "#BBDEFB"; stroke: "#1565C0"; font-color: "#0D47A1"; stroke-width: 2; bold: true }
  artifacts: "specs (.tla)" {
    grid-columns: 1
    style.fill: "#E3F2FD"; style.stroke: "#1565C0"; style.font-color: "#0D47A1"
    lin: "LockFreeARTrie\nLinearizability" { style.fill: "#E3F2FD"; style.stroke: "#1565C0"; style.font-color: "#0D47A1" }
    crash: "CrashRecovery" { style.fill: "#E3F2FD"; style.stroke: "#1565C0"; style.font-color: "#0D47A1" }
    front: "DurabilityFrontier" { style.fill: "#E3F2FD"; style.stroke: "#1565C0"; style.font-color: "#0D47A1" }
    ebr: "EvictionWalkEBR" { style.fill: "#E3F2FD"; style.stroke: "#1565C0"; style.font-color: "#0D47A1" }
  }
  props: "properties" {
    grid-columns: 1
    style.fill: "#E1F5FE"; style.stroke: "#0277BD"; style.font-color: "#01579B"
    p1: "Linearizability" { style.fill: "#E1F5FE"; style.stroke: "#0277BD"; style.font-color: "#01579B" }
    p2: "No-lost-writes" { style.fill: "#E1F5FE"; style.stroke: "#0277BD"; style.font-color: "#01579B" }
    p3: "Crash-recovery\ncompleteness" { style.fill: "#E1F5FE"; style.stroke: "#0277BD"; style.font-color: "#01579B" }
  }
  artifacts -> props: "TLC: 0 violations" { style.stroke: "#1565C0"; style.stroke-width: 2 }
}

impl: "Persistent ART (PART) — Rust under test\nsrc/persistent_artrie/ · overlay · WAL · arena" {
  style: { fill: "#ECEFF1"; stroke: "#546E7A"; font-color: "#263238"; stroke-width: 2; bold: true }
}

harness: "Correspondence harness\nverify-formal-correspondence.sh:\nRust traces ⇔ Rocq make ⇔ TLA⁺ SANY ⇔ unsafe gate" {
  style: { fill: "#FFE0B2"; stroke: "#EF6C00"; font-color: "#E65100"; stroke-width: 2; bold: true }
}

# The Rocq prong (rocq → impl, harness → rocq) lives in the companion figure
# proof-artifact-map-2.d2; here we keep only the TLA⁺-side ties.
harness -> tla: "SANY + TLC" { style.stroke: "#EF6C00"; style.stroke-width: 2; style.stroke-dash: 3 }
tla -> impl: "models concurrency\n+ crash of" { style.stroke: "#1565C0"; style.stroke-width: 2 }
harness -> impl: "trace tests" { style.stroke: "#EF6C00"; style.stroke-width: 3; style.bold: true }

legend: |md
  🟦 model-checked (TLA⁺) · 🟧 harness · ⬜ under test

  *🟩 theorem-proved (Rocq) prong → companion figure proof-artifact-map-2*
| { near: bottom-center; style.font-size: 13; style.font-color: "#37474F" }
