# =============================================================================
# persistence-stack.d2 — PART ① of the PersistentARTrie lock-free durable
# persistence stack: the six layers ①–⑥ and the live WRITE + READ paths.
# A WRITE descends through a durable WAL before it publishes; a READ traverses
# only the overlay. The checkpoint fold, the reopen replay, and the cross-cutting
# concurrency/eviction concerns are the companion figure persistence-stack-2.d2.
# Split from the original single figure (was 1581px) so each part fits the prose
# column; the same technique as architecture→architecture-2 / kernel-substrate→-2.
#
# Color key (house palette + persistence accents — docs/diagrams/README.md):
#   green  #C8E6C9  client API / in-memory        teal   #B2DFDB  lock-free overlay
#   orange #FFCC80  WAL / durability              indigo #C5CAE9  checkpoint / image
#   blue   #BBDEFB  persistent / disk-backed      red    #FFCDD2  locks / serialization
#   grey   #F1F1F1  infrastructure
# =============================================================================

vars: { d2-config: { layout-engine: elk } }
direction: down

title: |md
  # Persistence stack — part ①

  *layers ①–⑥ · the WRITE + READ paths*
| { near: top-center; style.font-size: 16; style.font-color: "#212121" }

api: "① Client API" {
  grid-columns: 1
  style: { fill: "#C8E6C9"; stroke: "#2E7D32"; font-color: "#1B5E20"; stroke-width: 2; bold: true }
  surface: "PersistentARTrie · …Char · …U64 · …Vocab\ninsert · upsert · get · iter_prefix" {
    style.fill: "#E8F5E9"; style.stroke: "#2E7D32"; style.font-color: "#1B5E20" }
}

overlay: "② Lock-free overlay engine" {
  grid-columns: 1
  style: { fill: "#B2DFDB"; stroke: "#00695C"; font-color: "#004D40"; stroke-width: 2; bold: true }
  node: "node · atomic_ptr\nOverlayNode<K,V> · arc-swap root" {
    style.fill: "#E0F2F1"; style.stroke: "#00695C"; style.font-color: "#004D40" }
  cas_walk: "cas_walk\ncopy-on-write · child/root CAS" {
    style.fill: "#E0F2F1"; style.stroke: "#00695C"; style.font-color: "#004D40" }
  durable_write: "durable_write\nOrder-A skeleton" {
    style.fill: "#E0F2F1"; style.stroke: "#00695C"; style.font-color: "#004D40" }
}

durability: "③ WAL + durability" {
  grid-columns: 1
  style: { fill: "#FFCC80"; stroke: "#EF6C00"; font-color: "#5D4037"; stroke-width: 2; bold: true }
  wal: "wal\nappend + fsync · 15 record types\nCRC fail-closed" {
    style.fill: "#FFF3E0"; style.stroke: "#EF6C00"; style.font-color: "#5D4037" }
  policy: "durability\nImmediate | GroupCommit\n| Periodic | None" {
    style.fill: "#FFF3E0"; style.stroke: "#EF6C00"; style.font-color: "#5D4037" }
  watermark: "committed_watermark\nthe only safe checkpoint_lsn" {
    style.fill: "#FFF3E0"; style.stroke: "#EF6C00"; style.font-color: "#5D4037" }
}

buffer: "④ Buffer manager" {
  grid-columns: 1
  style: { fill: "#F1F1F1"; stroke: "#607D8B"; font-color: "#263238"; stroke-width: 2; bold: true }
  bm: "buffer_manager\nframe pool · fault-in · flush" {
    style.fill: "#FAFAFA"; style.stroke: "#607D8B"; style.font-color: "#263238" }
  dirty: "dirty_tracker\ndirty set · batched flush" {
    style.fill: "#FAFAFA"; style.stroke: "#607D8B"; style.font-color: "#263238" }
}

disk: "⑤ Disk manager (BlockStorage seam)" {
  grid-columns: 1
  style: { fill: "#BBDEFB"; stroke: "#1565C0"; font-color: "#0D47A1"; stroke-width: 2; bold: true }
  mmap: "Mmap (DEFAULT)\npage-cache · single-block I/O" {
    style.fill: "#E3F2FD"; style.stroke: "#1565C0"; style.font-color: "#0D47A1" }
  iouring: "IoUring (feature)\nO_DIRECT · batched async I/O" {
    style.fill: "#E3F2FD"; style.stroke: "#1565C0"; style.font-color: "#0D47A1" }
}

arena: "⑥ Arena · block storage" {
  grid-columns: 1
  style: { fill: "#BBDEFB"; stroke: "#1565C0"; font-color: "#0D47A1"; stroke-width: 2; bold: true }
  slots: "arena_slot · block_storage\n256 KB blocks · swizzled ptrs · buckets" {
    style.fill: "#E3F2FD"; style.stroke: "#1565C0"; style.font-color: "#0D47A1" }
}

# --- WRITE path (orange = the durable gate before publish) -------------------
api -> overlay: "1 · write enters" { style.stroke: "#37474F"; style.stroke-width: 2 }
overlay -> durability: "2 · WAL append+fsync\nBEFORE publish" { style.stroke: "#EF6C00"; style.stroke-width: 3; style.bold: true }
durability -> buffer: "3 · stage pages" { style.stroke: "#37474F"; style.stroke-width: 2 }
buffer -> disk: "4 · flush blocks" { style.stroke: "#1565C0"; style.stroke-width: 2 }
disk -> arena: "5 · arena slots" { style.stroke: "#1565C0"; style.stroke-width: 2 }

# --- READ path (teal dashed = overlay only) ---------------------------------
api -> overlay: "READ · overlay only\n(no WAL/disk)" { style.stroke: "#00695C"; style.stroke-width: 3; style.stroke-dash: 4; style.bold: true }

# Legend wrapped into short paragraphs (blank line between each) so no single
# line drives the width past the prose column — the color row with 5 emoji is
# split across two lines.
legend: |md
  🟩 API · 🟦 overlay · 🟧 WAL

  ⬜ buffer · 🟦 disk/arena

  *checkpoint, reopen & cross-cutting →*

  *companion figure persistence-stack-2*
| { near: bottom-center; style.font-size: 13; style.font-color: "#37474F" }
