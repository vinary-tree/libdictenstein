@startuml art-insert-path-compression
' ============================================================================
' art-insert-path-compression.puml — inserting 'testament' into a compressed
' node whose partial is 'test' and whose only child is leaf('testing'): the two
' keys agree through 'test' then diverge at position 4 ('i' vs 'a'), so the node
' gains a second child edge and both diverging suffixes become leaves.
' Source: docs/theory/disk-tries/03-adaptive-radix-tree.md,
' § Path Compression During Insert.
' Color key:  blue #BBDEFB = compressed inner node · green #C8E6C9 = leaves
' ============================================================================
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam rectangle {
  BorderColor #37474F
  FontColor #212121
  BorderThickness 1.2
}
skinparam packageStyle rectangle
skinparam ArrowColor #37474F
skinparam TitleFontSize 15

title Path compression during insert — 'testament' beside 'testing'

package "Before" #F5F5F5 {
  rectangle "node\npartial = 'test'" as BN #BBDEFB
  rectangle "leaf\n'testing'" as BL #C8E6C9
  BN --> BL
}

package "After" #F5F5F5 {
  rectangle "node\npartial = 'test'" as AN #BBDEFB
  rectangle "leaf\n'ing'" as AI #C8E6C9
  rectangle "leaf\n'ament'" as AA #C8E6C9
  AN --> AI : 'i'
  AN --> AA : 'a'
}

BL -[hidden]down- AN

legend bottom
  Keys agree through 'test', then diverge at position 4
  ('i' vs 'a'): the node splits and gains a second child edge.
endlegend
@enduml
