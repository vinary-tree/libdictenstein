@startuml swmr-architecture
' SWMR — single-writer / multi-reader-PROCESS access to one vocab file (single host).
' Rendered by scripts/render-diagrams.sh → ../swmr-architecture.svg (embedded by
' docs/design/swmr-multiprocess.md).
skinparam backgroundColor #FDFDFD
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam componentStyle rectangle
skinparam ArrowColor #5F6368
skinparam noteBackgroundColor #FFF8E1
skinparam noteBorderColor #E0C060

title SWMR — one writer process ∥ N reader processes over one vocab file (single host)

node "Writer process\n(holds exclusive .wlock — Tier-1)" as W #E8F0FE {
  component "PersistentVocabARTrie\nlock-free overlay: AtomicNodePtr + DashMaps\n(reads + writes — HOT path, unchanged)" as WT #D2E3FC
  component "checkpoint_overlay\nserialize → temp → fsync → rename\n(COLD path, under checkpoint_lock)" as WC #AECBFA
}

node "Reader process 1\n(holds shared .rlock)" as R1 #E6F4EA {
  component "VocabReaderHandle\nArcSwap<ReaderSnapshot>\n(lock-free reads over a frozen snapshot)" as RH1 #CEEAD6
  component "refresh thread\npoll checkpoint_lsn; on bump:\nrebuild snapshot → ArcSwap.store" as RT1 #A8DAB5
}

node "Reader process N\n(holds shared .rlock)" as RN #E6F4EA {
  component "VocabReaderHandle" as RHN #CEEAD6
}

folder "Shared filesystem — single host, shared page cache" as FS #FEF7E0 {
  artifact "vocabulary.vocab\ncanonical inode — atomically\nREPLACED by rename each publish" as IMG #FDE293
  artifact ".wlock   (exclusive → single writer)" as WL #F6AEA9
  artifact ".rlock   (shared → reader presence)" as RL #F6AEA9
  artifact "vocabulary.vocab.wal\nwriter-only crash log (readers ignore)" as WAL #FDE293
}

WT --> WAL : durable append + root CAS\n(hot; never blocks readers)
WC --> IMG : write temp →\nfsync → **rename** (atomic publish)
W --> WL
R1 --> RL
RN --> RL
RT1 ..> IMG : poll checkpoint_lsn;\non bump open the NEW inode
RH1 ..> IMG : read-only mmap of the\nOLD inode (pinned by fd)
RHN ..> IMG

note bottom of FS
  Readers observe the last **durable checkpoint** (snapshot / MVCC consistency);
  staleness ≤ one checkpoint interval, never the writer's uncommitted overlay.
  Single host only — relies on local rename atomicity + page-cache coherence.
end note
@enduml
