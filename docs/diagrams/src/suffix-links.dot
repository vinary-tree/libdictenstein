// ============================================================================
// Suffix-link tree overlaid on the suffix automaton of  w = "abcabcab".
//
// States q0..q8 are the end-position equivalence classes (Blumer et al. 1985):
//     q0 {0..8}=ε   q1 {1,4,7}=a   q2 {2,5,8}=b,ab   q3 {3,6}=c,bc,abc
//     q4 {4,7}=ca…  q5 {5,8}=cab…  q6 {6}=cabc…       q7 {7}=cabca…
//     q8 {8}=cabcab…
//
// SOLID dark-slate edges  = δ transitions (labelled by a character).
// DASHED coloured edges    = SUFFIX LINKS  slink(q): each state's longest
// proper suffix that lands in a *different* class.  The suffix links form a
// TREE rooted at q0; reversing them gives, for any matched factor, every
// state whose factors end where the factor ends — the backbone of
// substring / occurrence (endpos) queries.
//
// Color key (house palette):
//   green  #C8E6C9  in-memory automaton states
//   blue   #BBDEFB  decorates the suffix-link tree edges
//   grey   #ECEFF1  the root q0 / infrastructure
//   dark slate #37474F  δ transitions + borders
// ============================================================================
digraph suffix_links {
    rankdir=LR;
    bgcolor="#FFFFFF";
    fontname="DejaVu Sans";
    labelloc="t";
    label="Suffix automaton of \"abcabcab\": solid = δ transitions, dashed blue = suffix-link tree (slink)";

    node [shape=circle, style="filled", fillcolor="#C8E6C9",
          color="#37474F", fontname="DejaVu Sans", fontcolor="#212121",
          penwidth=1.4, width=0.5];
    edge [color="#37474F", fontname="DejaVu Sans", fontcolor="#37474F",
          penwidth=1.3];

    // --- states ----------------------------------------------------------
    q0 [label="q0\nε", fillcolor="#ECEFF1", shape=doublecircle];
    q1 [label="q1"];
    q2 [label="q2"];
    q3 [label="q3"];
    q4 [label="q4"];
    q5 [label="q5"];
    q6 [label="q6"];
    q7 [label="q7"];
    q8 [label="q8", shape=doublecircle];

    // --- δ transitions (solid) — from the transition table ---------------
    q0 -> q1 [label="a"];
    q0 -> q2 [label="b"];
    q0 -> q3 [label="c"];
    q1 -> q2 [label="b"];
    q2 -> q4 [label="a"];
    q2 -> q3 [label="c"];
    q3 -> q4 [label="a"];
    q3 -> q5 [label="b"];
    q4 -> q5 [label="b"];
    q4 -> q6 [label="c"];
    q5 -> q7 [label="a"];
    q5 -> q6 [label="c"];
    q6 -> q7 [label="a"];
    q6 -> q8 [label="b"];
    q7 -> q8 [label="b"];

    // --- suffix links (dashed blue) — the slink tree, child ⇢ parent -----
    // constraint=false so the tree overlay does not perturb the δ layout.
    edge [color="#1565C0", style="dashed", arrowhead="vee",
          constraint=false, penwidth=1.6, fontcolor="#1565C0"];
    q1 -> q0 [label="slink"];
    q2 -> q0 [label="slink"];
    q3 -> q0 [label="slink"];
    q4 -> q1 [label="slink"];
    q5 -> q2 [label="slink"];
    q6 -> q3 [label="slink"];
    q7 -> q4 [label="slink"];
    q8 -> q5 [label="slink"];

    // --- rendered legend --------------------------------------------------
    { rank=sink;
      legend [shape=note, style="filled", fillcolor="#FFF9C4",
              color="#FBC02D", fontsize=10, fontcolor="#212121",
              label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1">
<TR><TD ALIGN="LEFT"><B>Legend</B></TD></TR>
<TR><TD ALIGN="LEFT"><FONT COLOR="#37474F">━━▶ δ transition (character-labelled)</FONT></TD></TR>
<TR><TD ALIGN="LEFT"><FONT COLOR="#1565C0">- -▶ slink (suffix link) → parent in tree</FONT></TD></TR>
<TR><TD ALIGN="LEFT">○ green state = endpos equivalence class</TD></TR>
<TR><TD ALIGN="LEFT">◎ double = root q0 (ε) / accepting q8</TD></TR>
<TR><TD ALIGN="LEFT">endpos(x) grows along slink toward q0</TD></TR>
</TABLE>>];
    }
}
