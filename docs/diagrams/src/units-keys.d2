# =============================================================================
# d2-layout: elk
# units-keys.d2 — the two unit/key abstractions and the shared, generic backends
#                 that consume them ("three alphabets, one code path").
#
# Source of truth:
#   src/char_unit.rs                              (CharUnit + u8/char/u64 impls)
#   src/persistent_artrie/core/key_encoding.rs    (KeyEncoding + ByteKey/CharKey/U64Key)
#   src/persistent_artrie/core/overlay/{node,atomic_ptr,dict_node}.rs
#                                                 (the generic OverlayNode<K,V> etc.)
#
# Each trait lists its three concrete unit/key impls (the alphabets); the trait then
# feeds the SINGLE generic implementation that is monomorphized once per alphabet and
# never re-implemented. Two parallel stories are stacked into one narrow column:
# CharUnit → the in-memory node, and KeyEncoding → the lock-free overlay. The seam
# that links them (KeyEncoding::Token is itself a CharUnit) is stated in the legend.
#
# Color key (house palette — docs/diagrams/README.md):
#   grey   #ECEFF1 / #37474F  unit/key TRAITS (each lists its concrete alphabet impls)
#   green  #C8E6C9  in-memory generic consumer (CharUnit-driven node trait)
#   blue   #BBDEFB  persistent / disk-backed generic consumer (KeyEncoding-driven overlay)
# =============================================================================

direction: down

title: |md
  # Two abstractions, every alphabet
  *`CharUnit` types the in-memory edge label · `KeyEncoding` the persistent key*

  *one generic implementation per consumer, monomorphized once per alphabet*
| {
  near: top-center
  style.font-size: 18
  style.font-color: "#212121"
}

# --- In-memory story: CharUnit (three alphabets) → the one generic node ---
charunit: "CharUnit  —  in-memory edge label  (src/char_unit.rs)\nu8: bytes · ASCII/Latin-1 · 1 B/edge\nchar: Unicode scalar · 4 B/edge\nu64: token / time-series label · 8 B/edge" {
  style.fill: "#ECEFF1"; style.stroke: "#37474F"; style.font-color: "#212121"; style.stroke-width: 2; style.bold: true
}
node_generic: "Generic in-memory node  —  DictionaryNode { Unit: CharUnit }\nDAT · DynamicDawg · SuffixAutomaton · Scdawg\n(+ their *Char / U64 siblings — same code per Unit)" {
  style.fill: "#C8E6C9"; style.stroke: "#2E7D32"; style.font-color: "#1B5E20"; style.stroke-width: 2; style.bold: true
}

# --- Persistent story: KeyEncoding (three keys) → the one generic overlay ---
keyencoding: "KeyEncoding  —  persistent-trie key  (core/key_encoding.rs)\nByteKey: Unit u8 · Token u8 · KEY_BYTES 1\nCharKey: Unit u32 · Token char · KEY_BYTES 4\nU64Key<PREFIX>: Unit u64 · Token u64 · KEY_BYTES 8" {
  style.fill: "#ECEFF1"; style.stroke: "#37474F"; style.font-color: "#212121"; style.stroke-width: 2; style.bold: true
}
overlay_generic: "Generic persistent overlay  —  core/overlay/  ·  OverlayNode<K: KeyEncoding, V>\nimmutable CoW · ChildStore<K::Unit, Child> · AtomicNodePtr arc-swap root\nOverlayDictionaryNode: Unit = K::Token (public) · stores K::Unit (compact)" {
  style.fill: "#BBDEFB"; style.stroke: "#1565C0"; style.font-color: "#0D47A1"; style.stroke-width: 2; style.bold: true
}

# --- Each trait feeds its single generic consumer (monomorphized per alphabet) ---
charunit -> node_generic: "monomorphized\nonce per Unit" { style.stroke: "#2E7D32"; style.stroke-width: 2; style.bold: true }
keyencoding -> overlay_generic: "monomorphized\nonce per K" { style.stroke: "#1565C0"; style.stroke-width: 2; style.bold: true }
# Hidden edge: stack the persistent story below the in-memory story (one column).
node_generic -> keyencoding: "" { style.opacity: 0.0 }

legend: |md
  **Color key** · ⬜ grey = unit/key *traits* (each lists its alphabets `u8`·`char`·`u64`) ·

  🟩 green = generic *in-memory* consumer (`CharUnit`) · 🟦 blue = generic *persistent* overlay (`KeyEncoding`) ·

  **seam:** `KeyEncoding::Token` is itself a `CharUnit`, so the persistent handle presents each variant's natural public unit.
| {
  near: bottom-center
  style.font-size: 13
  style.font-color: "#37474F"
}
