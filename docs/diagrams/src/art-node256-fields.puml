@startuml art-node256-fields
' ============================================================================
' art-node256-fields.puml — the Node256 struct layout (byte-ART, 49..256 children).
' Source of truth: src/persistent_artrie/nodes/node256.rs (§Layout comment, ~2076 B).
' Drawn as a CONTIGUOUS colored field table hosted in a floating note; rows share
' borders (no gaps). Layout = 16-B NodeHeader + 12-B CompressedPrefix + a direct
' 256-slot child array (no keys — the byte IS the index).
' Color key: green NodeHeader · light-blue inline prefix · mid-blue direct child array
' ============================================================================
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam TitleFontSize 15
skinparam noteFontSize 14
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #37474F
}

title Node256 — 49..256 children (~2076 B) · direct array

note as N256
|= field |= description |
|<#C8E6C9> NodeHeader : 16 B |<#C8E6C9> fixed 16-byte prefix — see node-header |
|<#E3F2FD> prefix : [u8; 12] |<#E3F2FD> inline compressed path (CompressedPrefix) |
|<#90CAF9> children : [SwizzledPtr; 256] |<#90CAF9> direct-access array — O(1) index (2048 B) |
end note

legend bottom
| Color | Field |
|<#C8E6C9>| NodeHeader — 16 B fixed prefix (see node-header) |
|<#E3F2FD>| inline compressed-path prefix (12 B) |
|<#90CAF9>| direct child array (SwizzledPtr, 8 B each) |
endlegend
@enduml
