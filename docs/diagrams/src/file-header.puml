@startuml file-header
' ============================================================================
' file-header.puml — the 64-byte PersistentARTrie FileHeader at block 0.
' Source of truth: src/persistent_artrie/core/disk_manager.rs (struct FileHeader,
' #[repr(C, align(64))]). Replaces the tiny bytefield SVG with a compact, colored,
' viewBox'd PlantUML byte-field (one row per field, offsets on the left).
' Color key (house palette + persistence accents — docs/diagrams/README.md):
'   green  #C8E6C9  identity (magic, version)
'   amber  #FFE0B2  flags / counters
'   teal   #B2DFDB  swizzled overlay root pointer
'   blue   #BBDEFB  allocator state (free-list head)
'   grey   #ECEFF1  alignment padding
'   purple #E1BEE7  integrity (CRC-64 checksum)
'   indigo #C5CAE9  checkpoint image-coverage frontier (#48, v2+)
' ============================================================================
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam rectangle {
  BorderColor #37474F
  FontColor #212121
  BorderThickness 1.2
}
skinparam TitleFontSize 15

title FileHeader — the 64-byte descriptor at block 0

rectangle "bytes **0..7**   magic = 0x5041525400010000  ('PART' v1.0)" as R0 #C8E6C9
rectangle "bytes **8..11**   version = 2" as R1 #C8E6C9
rectangle "bytes **12..15**   flags  (reserved)" as R2 #FFE0B2
rectangle "bytes **16..23**   root_ptr  — swizzled overlay root" as R3 #B2DFDB
rectangle "bytes **24..27**   block_count" as R4 #FFE0B2
rectangle "bytes **28..31**   _pad1  (alignment)" as R5 #ECEFF1
rectangle "bytes **32..39**   free_list_head  (0 = none)" as R6 #BBDEFB
rectangle "bytes **40..47**   entry_count" as R7 #FFE0B2
rectangle "bytes **48..55**   checksum  — CRC-64 of header" as R8 #E1BEE7
rectangle "bytes **56..63**   image_checkpoint_lsn  — #48 frontier (v2+)" as R9 #C5CAE9

R0 -[hidden]down- R1
R1 -[hidden]down- R2
R2 -[hidden]down- R3
R3 -[hidden]down- R4
R4 -[hidden]down- R5
R5 -[hidden]down- R6
R6 -[hidden]down- R7
R7 -[hidden]down- R8
R8 -[hidden]down- R9

legend bottom
  green identity · amber flags/counters · teal overlay-root ptr
  blue allocator · grey pad · purple CRC-64 · indigo checkpoint LSN
endlegend
@enduml
