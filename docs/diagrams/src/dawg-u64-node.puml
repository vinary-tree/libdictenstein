@startuml
' ============================================================================
' DynamicDawgU64 immutable-revision representation.
' Color key (house palette, see docs/diagrams/README.md):
'   #C8E6C9 green  — immutable in-memory graph revision and nodes
'   #B2DFDB teal   — sole lock-free ArcSwap publication cell
'   #F1F1F1 / #37474F — infrastructure / borders / arrows
' ============================================================================
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam shadowing false
skinparam ArrowColor #37474F
skinparam nodesep 12
skinparam ranksep 22
top to bottom direction
skinparam class {
  BorderColor #37474F
  FontColor #263238
}

object "DynamicDawgU64<V>" as dict #C8E6C9 {
  core : LockFreeDawg<u64, V>
}

object "version : ArcSwap<GraphVersion>" as version #B2DFDB {
  root-CAS publication point
}

object "GraphVersion<u64, V>" as revision #C8E6C9 {
  root : Arc<LockFreeDawgNode>
  term_count : usize
  needs_compaction : bool
  revision : u64
}

object "LockFreeDawgNode<u64, V>" as node #C8E6C9 {
  is_final : bool
  value : Option<Arc<V>>
}

object "edges : LockFreeEdgeList<u64, V>" as edges #C8E6C9 {
  SmallVec<[(u64, Arc<child>); 4]>
  inline up to 4 edges, then heap
  label-sorted; scan < 16, else binary
}

dict --> version
version --> revision : load / CAS
revision --> node : immutable root
node --> edges
edges ..> node : "Arc to child\n(one per u64 label)"

note bottom of edges #F1F1F1
  Reader: load one immutable root and retain it.
  Writer: path-copy one route, structurally share
  unchanged nodes, then root-CAS a new GraphVersion.
  A retained cursor never mixes revisions.
end note
@enduml
