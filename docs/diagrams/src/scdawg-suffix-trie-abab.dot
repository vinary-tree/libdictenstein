// ============================================================================
// scdawg-suffix-trie-abab.dot — the SUFFIX TRIE of "abab$", which explicitly
// stores every suffix as a distinct root-to-leaf path.  Common PREFIXES of
// suffixes are shared (the tree branches), but nothing else is, which is what
// makes the trie cost O(n^2) nodes in the worst case.  Source: §Suffix Trie of
// 01-introduction.md.
//
// Suffixes of "abab$":  abab$, bab$, ab$, b$, $.  Each ends at a leaf (double
// circle).  Node labels are the substring spelled from the root; edge labels
// are the single character added.
//
// Color key (house palette):
//   grey   #ECEFF1  the root ε
//   green  #C8E6C9  interior trie nodes (proper factors)
//   teal   #B2DFDB  leaves = complete suffixes (accepting)
//   dark slate #37474F  edges + node borders
// ============================================================================
digraph scdawg_suffix_trie {
    rankdir=TB;
    bgcolor="#FFFFFF";
    fontname="DejaVu Sans";
    fontsize=14;
    labelloc="t";
    fontcolor="#212121";
    label="Suffix trie of \"abab$\" — every suffix is an explicit path\n(double circle = leaf completing a suffix)";
    nodesep=0.25;
    ranksep=0.45;

    node [shape=circle, style="filled", fillcolor="#C8E6C9",
          color="#37474F", fontname="DejaVu Sans", fontcolor="#212121",
          penwidth=1.4, fixedsize=false, width=0.5];
    edge [color="#37474F", fontname="DejaVu Sans", fontcolor="#37474F",
          penwidth=1.3];

    root  [label="ε", fillcolor="#ECEFF1"];

    // branch under 'a' : suffixes abab$ and ab$
    a     [label="a"];
    ab    [label="ab"];
    aba   [label="aba"];
    abab  [label="abab"];
    ababS [label="abab$", shape=doublecircle, fillcolor="#B2DFDB"];
    abS   [label="ab$",   shape=doublecircle, fillcolor="#B2DFDB"];

    // branch under 'b' : suffixes bab$ and b$
    b     [label="b"];
    ba    [label="ba"];
    bab   [label="bab"];
    babS  [label="bab$", shape=doublecircle, fillcolor="#B2DFDB"];
    bS    [label="b$",   shape=doublecircle, fillcolor="#B2DFDB"];

    // branch under '$' : suffix $
    dollarS [label="$", shape=doublecircle, fillcolor="#B2DFDB"];

    root -> a       [label="a"];
    a    -> ab      [label="b"];
    ab   -> aba     [label="a"];
    aba  -> abab    [label="b"];
    abab -> ababS   [label="$"];
    ab   -> abS     [label="$"];

    root -> b       [label="b"];
    b    -> ba      [label="a"];
    ba   -> bab     [label="b"];
    bab  -> babS    [label="$"];
    b    -> bS      [label="$"];

    root -> dollarS [label="$"];
}
