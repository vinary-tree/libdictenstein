@startuml node-layouts
' ============================================================================
' node-layouts.puml — the adaptive ART node tiers (byte keys), grow with fan-out.
' Source of truth: src/persistent_artrie/nodes/{node4,node16,node48,node256}.rs.
' Replaces the no-viewBox svgbob SVG. Color: a light→dark blue progression per tier.
' ============================================================================
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam rectangle {
  BorderColor #1565C0
  FontColor #0D47A1
  BorderThickness 1.2
}
skinparam noteFontSize 13
skinparam TitleFontSize 15

title Adaptive ART node tiers (byte keys) — the layout grows with fan-out

rectangle "**Node4**    1..4 children\nparallel key[4] + child[4] arrays · linear scan" as N4 #E3F2FD
rectangle "**Node16**    5..16 children\nkey[16] + child[16] · SSE4.1 SIMD key compare" as N16 #BBDEFB
rectangle "**Node48**    17..48 children\n256-byte index → 48 child slots (2 loads)" as N48 #90CAF9
rectangle "**Node256**    49..256 children\ndirect 256-slot child array (O(1) index)" as N256 #64B5F6

N4 -[hidden]down- N16
N16 -[hidden]down- N48
N48 -[hidden]down- N256

note bottom of N256
  Char / u64 keys keep native labels: inline → sorted → sparse-indexed,
  and CharBucket at high fan-out (no 4 GB Node256 over u32).
end note
@enduml
