@startuml node-header
' ============================================================================
' node-header.puml — the 16-byte NodeHeader on every persistent ART node.
' Source of truth: src/persistent_artrie/nodes/mod.rs (struct NodeHeader).
' Drawn as a CONTIGUOUS colored byte table (offset column + field column, one row
' per field) hosted in a floating note; rows share borders (no gaps). Full-cell
' color via Creole |<#hex>| cells.
' Color key: green identity · amber flags/counters · grey padding · blue version
' ============================================================================
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam TitleFontSize 15
skinparam noteFontSize 14
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #37474F
}

title NodeHeader — the 16-byte fixed prefix on every ART node

note as NH
|= bytes |= field |
|<#C8E6C9> 0 |<#C8E6C9> node_type  (N4 / N16 / N48 / N256 / CharBucket) |
|<#C8E6C9> 1 |<#C8E6C9> prefix_len  (compressed-prefix length) |
|<#FFE0B2> 2 |<#FFE0B2> flags  (IS_FINAL · IS_DIRTY · IS_LEAF · HAS_DIRTY_DESCENDANTS) |
|<#ECEFF1> 3 |<#ECEFF1> _pad |
|<#FFE0B2> 4..5 |<#FFE0B2> num_children  (u16) |
|<#ECEFF1> 6..7 |<#ECEFF1> _pad2 |
|<#BBDEFB> 8..15 |<#BBDEFB> version  (u64 optimistic-lock counter) |
end note

legend bottom
| Color | Field |
|<#C8E6C9>| identity — node_type · prefix_len |
|<#FFE0B2>| flags / counters |
|<#ECEFF1>| alignment padding |
|<#BBDEFB>| optimistic-lock version |
endlegend
@enduml
