@startuml art-node48-fields
' ============================================================================
' art-node48-fields.puml — the Node48 struct layout (byte-ART, 17..48 children).
' Source of truth: src/persistent_artrie/nodes/node48.rs (§Layout comment, ~668 B).
' Drawn as a CONTIGUOUS colored field table hosted in a floating note; rows share
' borders (no gaps). Layout = 16-B NodeHeader + 12-B CompressedPrefix + 256-B
' child_index + children.
' Color key: green NodeHeader · light-blue inline prefix · blue byte→slot index ·
'            mid-blue child pointers
' ============================================================================
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam TitleFontSize 15
skinparam noteFontSize 14
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #37474F
}

title Node48 — 17..48 children (~668 B) · index + direct

note as N48
|= field |= description |
|<#C8E6C9> NodeHeader : 16 B |<#C8E6C9> fixed 16-byte prefix — see node-header |
|<#E3F2FD> prefix : [u8; 12] |<#E3F2FD> inline compressed path (CompressedPrefix) |
|<#BBDEFB> child_index : [u8; 256] |<#BBDEFB> maps byte → slot (255 = empty) |
|<#90CAF9> children : [SwizzledPtr; 48] |<#90CAF9> child pointers in slots (384 B) |
end note

legend bottom
| Color | Field |
|<#C8E6C9>| NodeHeader — 16 B fixed prefix (see node-header) |
|<#E3F2FD>| inline compressed-path prefix (12 B) |
|<#BBDEFB>| byte→slot index (256 B) |
|<#90CAF9>| child pointers (SwizzledPtr, 8 B each) |
endlegend
@enduml
