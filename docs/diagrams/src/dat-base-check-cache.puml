@startuml dat-base-check-cache
' ============================================================================
' dat-base-check-cache.puml — sequential BASE/CHECK access vs pointer chasing.
' Replaces the ASCII cache-behavior comparison in
' docs/algorithms/implementations/double-array-trie.md.
' Color key:  green = contiguous BASE/CHECK arrays (prefetcher-friendly)
'             red = random pointer chasing (a cache miss per hop)
' ============================================================================
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam ArrowColor #37474F
skinparam packageStyle rectangle
skinparam rectangle {
  BorderColor #37474F
  FontColor #212121
  BorderThickness 1.1
}
skinparam noteFontSize 13
skinparam TitleFontSize 15

title Query "test" — memory-access pattern

package "Double-array: sequential BASE / CHECK arrays" #E8F5E9 {
  rectangle "BASE[0]" as A0 #C8E6C9
  rectangle "CHECK[t] · BASE[t]\n(prefetched — same cache line)" as A1 #C8E6C9
  rectangle "CHECK[te] · BASE[te]\n(prefetched)" as A2 #C8E6C9
  rectangle "… → hit" as A3 #C8E6C9
  A0 --> A1
  A1 --> A2
  A2 --> A3
  note right of A2 : contiguous arrays · CPU prefetcher-friendly
}

package "Traditional trie: pointer chasing" #FFEBEE {
  rectangle "Node* root" as N0 #FFCDD2
  rectangle "Node* t" as N1 #FFCDD2
  rectangle "Node* te" as N2 #FFCDD2
  rectangle "Node* tes" as N3 #FFCDD2
  rectangle "Node* test" as N4 #FFCDD2
  N0 --> N1
  N1 --> N2
  N2 --> N3
  N3 --> N4
  note right of N2 : each hop = random address → **cache miss**
}

A3 -[hidden]down- N0
@enduml
