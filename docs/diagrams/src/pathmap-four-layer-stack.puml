@startuml pathmap-four-layer-stack
' ============================================================================
' pathmap-four-layer-stack.puml — the three integration layers over PathMap storage.
' Replaces the ASCII 4-tier stack in docs/integration/pathmap/README.md.
' Color key:  green = MeTTa query syntax (top)   amber = MORK adapters
'             teal = liblevenshtein + PathMap API   blue = shared PathMap storage
' ============================================================================
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam ArrowColor #37474F
skinparam rectangle {
  BorderColor #37474F
  FontColor #212121
  BorderThickness 1.1
}
skinparam TitleFontSize 15

title Three integration layers over shared PathMap storage

rectangle "**Layer 3 — MeTTa Query Syntax**\n!(match &space (fuzzy-phonetic “fone” 2 $r) $r)\n!(match &space (fuzzy “colr” 2 $r) $r)\nuser-facing query language (phonetic-aware + standard)" as L3 #C8E6C9
rectangle "**Layer 2 — MORK Fuzzy(Phonetic)Source adapters**\nFuzzyPhoneticSource → PhoneticNormalizedDictionary.query()\nFuzzySource → standard Levenshtein transducer\nMORK/kernel/src/fuzzy_source.rs" as L2 #FFE0B2
rectangle "**Layer 1 — liblevenshtein + PathMap**\nPhoneticNormalizedDictionary · PathMapDictionary backend\nliblevenshtein-rust/src/dictionary/" as L1 #B2DFDB
rectangle "**PathMap Storage (Shared)**\nmemory-mapped trie shared by liblevenshtein and MORK\nsame data used by BTMSource, ACTSource, PathMapDictionary" as L0 #BBDEFB

L3 --> L2
L2 --> L1
L1 --> L0
@enduml
