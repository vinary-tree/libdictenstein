// ============================================================================
// scdawg-evolution.dot — the lineage of space-efficient substring indices that
// culminates in the SCDAWG.  Each node is a structure (with the year/authors
// that introduced it); each edge is the transformation that derives the next
// structure from the previous one.  Source: §Evolution of Substring Structures
// of 01-introduction.md.
//
//   Suffix Trie  --compact non-branching paths-->  Suffix Tree
//                --share common suffixes-->        Suffix Automaton / DAWG
//                --compact non-branching paths-->  CDAWG
//                --add left-extension edges-->     SCDAWG
//
// Color key (house palette):
//   grey   #ECEFF1  the early, space-hungry structures (trie / tree)
//   green  #C8E6C9  the DAWG-family automata (DAWG, CDAWG)
//   teal   #B2DFDB  the SCDAWG — the target structure of this documentation
//   dark slate #37474F  derivation edges + node borders
// ============================================================================
digraph scdawg_evolution {
    rankdir=TB;
    bgcolor="#FFFFFF";
    fontname="DejaVu Sans";
    fontsize=14;
    labelloc="t";
    fontcolor="#212121";
    label="Evolution of substring-index structures\n(each edge is the transformation to the next structure)";
    nodesep=0.30;
    ranksep=0.55;

    node [shape=box, style="filled,rounded", fillcolor="#ECEFF1",
          color="#37474F", fontname="DejaVu Sans", fontcolor="#212121",
          penwidth=1.4, margin="0.14,0.07"];
    edge [color="#37474F", fontname="DejaVu Sans", fontcolor="#37474F",
          penwidth=1.3];

    trie   [label="Suffix Trie\n(1960s)"];
    tree   [label="Suffix Tree\n(1973 Weiner; 1976 McCreight)"];
    dawg   [label="Suffix Automaton / DAWG\n(1985 Blumer et al.)", fillcolor="#C8E6C9"];
    cdawg  [label="CDAWG\n(1997 Crochemore & Vérin)", fillcolor="#C8E6C9"];
    scdawg [label="SCDAWG\n(1987 Blumer et al.; 2001 Inenaga et al.)",
            fillcolor="#B2DFDB", penwidth=2.0];

    trie  -> tree   [label="  compact non-branching paths"];
    tree  -> dawg   [label="  share common suffixes"];
    dawg  -> cdawg  [label="  compact non-branching paths"];
    cdawg -> scdawg [label="  add left-extension edges"];

    // --- rendered legend -------------------------------------------------
    { rank=sink;
      legend [shape=note, style="filled", fillcolor="#FFF9C4",
              color="#FBC02D", fontsize=10, fontcolor="#212121",
              label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1">
<TR><TD ALIGN="LEFT"><B>Legend</B></TD></TR>
<TR><TD ALIGN="LEFT">grey = early space-hungry structures (trie, tree)</TD></TR>
<TR><TD ALIGN="LEFT"><FONT COLOR="#2E7D32">green</FONT> = DAWG-family automata (DAWG, CDAWG)</TD></TR>
<TR><TD ALIGN="LEFT"><FONT COLOR="#00695C">teal</FONT> = SCDAWG (the structure this documentation builds)</TD></TR>
<TR><TD ALIGN="LEFT">━━▶ = transformation deriving the next structure</TD></TR>
</TABLE>>];
    }
}
