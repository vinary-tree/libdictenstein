@startuml part-sequential-blocks
' ============================================================================
' part-sequential-blocks.puml — Strategy 1: sequential allocation. Serialized
' nodes are packed into blocks in arrival order; simple but fragments over time.
' Source: docs/theory/disk-tries/04-persistent-art.md, § Block Allocation Strategies.
' Color key:  blue #BBDEFB  packed nodes   grey #ECEFF1  free space
' ============================================================================
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam rectangle {
  BorderColor #37474F
  FontColor #212121
  BorderThickness 1.2
}
skinparam packageStyle rectangle
skinparam TitleFontSize 15

title Strategy 1 — sequential allocation (arrival order)

package "Block 0" #F5F5F5 {
  rectangle "Node A" as A #BBDEFB
  rectangle "Node B" as B #BBDEFB
  rectangle "Node C" as C #BBDEFB
  rectangle "Node D" as D #BBDEFB
  rectangle "free space" as F0 #ECEFF1
  A -[hidden]right- B
  B -[hidden]right- C
  C -[hidden]right- D
  D -[hidden]right- F0
}

package "Block 1" #F5F5F5 {
  rectangle "Node E" as E #BBDEFB
  rectangle "Node F" as G #BBDEFB
  rectangle "free space" as F1 #ECEFF1
  E -[hidden]right- G
  G -[hidden]right- F1
}

A -[hidden]down- E

legend bottom
  Simple to implement · leads to fragmentation as nodes are added and freed.
endlegend
@enduml
