@startuml zipper-lattice
' ============================================================================
' zipper-lattice.puml — the value-merge lattice (Hasse diagram).
'
' When the SAME term appears in two operands of a combinator, the two values
' must be reconciled into one. The combinators reconcile via a
' `ValueMergeStrategy`; for value types that form a `Lattice` (the `llattice`
' crate: join = least upper bound, meet = greatest lower bound) the two
' canonical strategies are:
'     LatticeJoin  ->  existing.join(&new)   (∪ / max / OR)   — climbs UP   the lattice
'     LatticeMeet  ->  existing.meet(&new)   (∩ / min / AND)  — descends DOWN the lattice
' Non-lattice strategies (FirstWins default for union, LastWins) just pick a
' side and are shown for contrast.
'
' This Hasse diagram draws the partial order for HashSet<{a,b,c}> ordered by ⊆
' (the prototypical bounded-below lattice): edges go LOW -> HIGH (subset below
' superset). join climbs to the least common UPPER bound; meet descends to the
' greatest common LOWER bound. ⊥ = ∅ is the bottom; for this finite universe the
' top ⊤ = {a,b,c} (an unbounded element type has no ⊤).
' Source of truth: union_zipper/lattice.rs + merge_strategies.rs; llattice/src/lib.rs.
'
' Color key:
'   green  (#C8E6C9) = lattice elements (candidate merged values, in-memory)
'   amber  (#FFF59D) = JOIN result of the worked example {a}⊔{b,c} = {a,b,c}
'   blue   (#BBDEFB) = MEET result of the worked example {a,b}⊓{b,c} = {b}
'   grey   (#ECEFF1 / #37474F) = bottom ⊥ / borders / order edges
' ============================================================================
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam wrapWidth 150
skinparam ArrowColor #37474F
skinparam shadowing false
skinparam rectangle {
  BorderColor #37474F
  FontName "DejaVu Sans"
}

title Value-merge lattice — <latex>\mathcal{P}(\{a,b,c\})</latex> ordered by <latex>\subseteq</latex>\n(join = <latex>\cup</latex> climbs up · meet = <latex>\cap</latex> descends down)

' --- Lattice elements (levels low -> high) ----------------------------------
rectangle "<latex>\top = \{a,b,c\}</latex>\n(JOIN <latex>\{a\} \sqcup \{b,c\}</latex>)" as TOP #FFF59D
rectangle "<latex>\{a, b\}</latex>" as AB #C8E6C9
rectangle "<latex>\{a, c\}</latex>" as AC #C8E6C9
rectangle "<latex>\{b, c\}</latex>" as BC #C8E6C9
rectangle "<latex>\{a\}</latex>" as A #C8E6C9
rectangle "<latex>\{b\}</latex>\n(MEET <latex>\{a,b\} \sqcap \{b,c\}</latex>)" as B #BBDEFB
rectangle "<latex>\{c\}</latex>" as C #C8E6C9
rectangle "<latex>\bot = \emptyset</latex>\n(bottom;\nmeet of disjoints)" as BOT #ECEFF1

' --- Cover relations (Hasse edges): lower ⊆ upper, drawn upward -------------
BOT -up-> A
BOT -up-> B
BOT -up-> C
A  -up-> AB
A  -up-> AC
B  -up-> AB
B  -up-> BC
C  -up-> AC
C  -up-> BC
AB -up-> TOP
AC -up-> TOP
BC -up-> TOP

' --- Worked-example merge arrows (the two strategies in action) --------------
A  -[#F9A825,thickness=3]-> TOP : "JOIN\n{a}⊔{b,c}"
BC -[#F9A825,thickness=3]-> TOP
AB -[#1565C0,thickness=3,dashed]-> B : "MEET\n{a,b}⊓{b,c}"
BC -[#1565C0,thickness=3,dashed]-> B

legend bottom
  |= Strategy |= Operation |= Direction |= Ex. |
  |<#FFF59D> LatticeJoin | join(&new) ∪/max/OR | UP (LUB) | {a,b,c} |
  |<#BBDEFB> LatticeMeet | meet(&new) ∩/min/AND | DOWN (GLB) | {b} |
  |<#C8E6C9> FirstWins* | keep existing | picks left | first |
  |<#C8E6C9> LastWins | take new | picks right | last |
  * union default.  Laws: idempotent · commutative · associative · absorptive.
endlegend
@enduml
