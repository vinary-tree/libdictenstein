@startuml zipper-term-tree
' ============================================================================
' zipper-term-tree.puml — the term-tree a DictZipper walks, for {cat,car,cab}.
' Replaces the ASCII term-tree in docs/algorithms/zippers.md.
' Color key:  grey = interior node (partial prefix)   green = final (complete term)
'             edge labels carry the descend() unit; the note shows children()
' ============================================================================
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam ArrowColor #37474F
skinparam rectangle {
  BorderColor #37474F
  FontColor #212121
  BorderThickness 1.1
}
skinparam noteBackgroundColor #B2DFDB
skinparam noteBorderColor #00796B
skinparam TitleFontSize 15

title Term-tree for { "cat", "car", "cab" } — a DictZipper is a cursor at one node

rectangle "(root)\npath = [ ]" as R #ECEFF1
rectangle "( )\npath = “c”" as C #ECEFF1
rectangle "( )\npath = “ca”" as CA #ECEFF1
rectangle "✓ **cat**\nis_final = true" as CAT #C8E6C9
rectangle "✓ **car**\nis_final = true" as CAR #C8E6C9
rectangle "✓ **cab**\nis_final = true" as CAB #C8E6C9

R --> C : descend('c')
C --> CA : descend('a')
CA --> CAT : 't'
CA --> CAR : 'r'
CA --> CAB : 'b'

note right of CA
  children() →
  ('t', ●) ('r', ●) ('b', ●)
end note
@enduml
