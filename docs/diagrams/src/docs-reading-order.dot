// ============================================================================
// docs-reading-order.dot — the documentation reading-path / prerequisite map,
// PART 1 of 2: tracks 1–2 (Getting-started + Theory).
//
// Visualizes the "Suggested reading order" in docs/README.md as a directed
// graph: every NODE is a doc (or doc section) and every EDGE is the recommended
// reading order / prerequisite flow ("read the tail before the head"). New
// readers enter top-left at the crate README and follow the green spine through
// the trait layer; the grey cluster is the first depth track they branch into.
// The three cross-track edges that leave these tracks (into Persistence and
// Formal) terminate at a "→ see part 2" note; PART 2
// (docs-reading-order-2.dot) draws the Persistence (blue) + Formal (amber)
// tracks and re-attaches those edges from a matching "from part 1 →" note.
//
// Layout: top-to-bottom (rankdir=TB). Nodes are grouped into colored clusters
// by track so the reading paths stay glanceable:
//   1. Getting started / usage  (green)  — README, backend selector, user guide,
//                                           the trait layer, per-backend guides.
//   2. Theory                   (grey)   — the paper-grounded disk-trie + SCDAWG
//                                           foundations and core abstractions.
//   (3. Persistence / systems — blue,  and 4. Formal / verification — amber,
//    are drawn in PART 2.)
//
// Color key (extends the house palette — docs/diagrams/README.md):
//   green  #C8E6C9  getting-started / usage   (entry spine: README → traits → backends)
//   grey   #ECEFF1  theory                    (disk-tries, SCDAWG, abstractions)
//   blue   #BBDEFB  persistence / systems      (PART 2)
//   amber  #FFF59D  formal / verification      (PART 2)
//   dark slate #37474F  reading-order edges + node borders
//   teal   #00897B  cross-track "go deeper" edges (usage → theory / → part 2)
// Cluster fills are a paler tint of each track color so the nodes stay readable.
// ============================================================================
digraph docs_reading_order {
    rankdir=TB;            // new readers enter at the top, depth grows downward
    bgcolor="#FFFFFF";
    fontname="DejaVu Sans";
    labelloc="t";
    fontsize=15;
    fontcolor="#212121";
    label=<<B>libdictenstein docs — reading order (part 1 of 2)</B><BR/><FONT POINT-SIZE="11">tracks 1&#8211;2: getting-started (green spine) &#8594; theory (grey).<BR/>Persistence (blue) &amp; formal (amber) tracks continue in part 2.</FONT>>;
    nodesep=0.18;
    ranksep=0.50;
    newrank=true;
    compound=true;        // allow edges to/from cluster boundaries

    node [shape=box, style="filled,rounded", color="#37474F",
          fontname="DejaVu Sans", fontcolor="#212121", penwidth=1.6,
          margin="0.10,0.07"];
    edge [color="#37474F", fontname="DejaVu Sans", fontcolor="#37474F",
          penwidth=1.6, arrowsize=0.9];

    // === 1. Getting started / usage (green spine) ==========================
    subgraph cluster_usage {
        label=<<B>1 · Getting started / usage</B>>;
        labeljust="l";
        fontsize=12;
        fontcolor="#1B5E20";
        style="filled,rounded";
        fillcolor="#E8F5E9";
        color="#66BB6A";
        penwidth=1.4;
        margin=8;

        readme    [label="Crate README\n(overview)", fillcolor="#C8E6C9"];
        selector  [label="Backend selector\n(README\n§backend-selector)", fillcolor="#C8E6C9"];
        guide     [label="user-guide/\nbackends.md", fillcolor="#C8E6C9"];
        traits    [label="algorithms/\nREADME.md\n(trait layer:\nDictionary ·\nMappedDictionary)", fillcolor="#C8E6C9"];
        backends  [label="algorithms/\nimplementations/\n(per-backend\ndeep dives:\nDAT · DAWG ·\nsuffix automaton)", fillcolor="#C8E6C9"];
        zippers   [label="algorithms/\nzippers.md\n(lazy\nset-algebra)", fillcolor="#C8E6C9"];
        serial    [label="algorithms/\nserialization.md\n(serialize\n+ values)", fillcolor="#C8E6C9"];
    }

    // === 2. Theory (grey) ==================================================
    subgraph cluster_theory {
        label=<<B>2 · Theory (paper-grounded)</B>>;
        labeljust="l";
        fontsize=12;
        fontcolor="#37474F";
        style="filled,rounded";
        fillcolor="#FAFAFA";
        color="#B0BEC5";
        penwidth=1.4;
        margin=8;

        abstractions [label="architecture/\nabstractions.md\n(CharUnit ·\nKeyEncoding:\none code path,\nthree alphabets)", fillcolor="#ECEFF1"];
        disktries    [label="theory/disk-tries/\n(trie → B-trie\n→ ART →\npersistent ART\n→ buffers)", fillcolor="#ECEFF1"];
        scdawg       [label="theory/scdawg/\n(suffix automaton\n→ CDAWG →\nsymmetric\ncompact DAWG)", fillcolor="#ECEFF1"];
    }

    // === "→ see part 2" note — the cross-track edges leave here ============
    // Persistence (blue) + Formal (amber) tracks live in docs-reading-order-2.
    see_part2 [shape=note, style="filled", fillcolor="#FFF9C4",
               color="#FBC02D", fontsize=11, fontcolor="#212121",
               label="→ see PART 2\n(docs-reading-order-2):\nPersistence (blue) &\nFormal (amber) tracks"];

    // === reading-order edges (green spine) =================================
    readme   -> selector  [label="pick a backend"];
    selector -> guide;
    guide    -> traits    [label="understand the\ntrait layer"];
    traits   -> backends  [label="go deep on\nyour backend"];
    backends -> zippers   [label="compose"];
    backends -> serial    [label="persist in-mem"];

    // layout-only: stack the two theory sub-tracks vertically (they are
    // independent reads — this invisible edge only narrows the figure, it
    // implies no prerequisite between disk-tries and SCDAWG).
    disktries -> scdawg [style="invis"];

    // === cross-track: usage → theory (teal "go deeper") ====================
    edge [color="#00897B", fontcolor="#00695C", penwidth=1.5, style="solid"];
    traits   -> abstractions [label="the unit\nabstractions"];
    backends -> disktries    [ltail=cluster_usage, lhead=cluster_theory,
                               label="theory back-link"];
    backends -> scdawg       [label="substring\ntheory"];

    // === cross-track: usage/theory → PART 2 (teal, terminates at the note) =
    // (backends → persist_arch, disktries → persist_arch, scdawg → suffixgraph
    //  are re-attached in part 2 from the matching "from part 1 →" note.)
    backends  -> see_part2 [label="need\ndurability →"];
    disktries -> see_part2 [label="foundations →"];
    scdawg    -> see_part2 [label="durable\nmirror →"];

    // === rendered legend (part 1: edge types + green/grey track key) =======
    legend [shape=note, style="filled", fillcolor="#FFF9C4",
            color="#FBC02D", fontsize=10, fontcolor="#212121",
            label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1">
<TR><TD ALIGN="LEFT"><B>Reading-order map &#8212; legend (part 1 of 2)</B></TD></TR>
<TR><TD ALIGN="LEFT"><FONT COLOR="#37474F">&#9472;&#9472;&#9654; recommended next read (prerequisite flow)</FONT></TD></TR>
<TR><TD ALIGN="LEFT"><FONT COLOR="#00897B">&#9472;&#9472;&#9654; "go deeper" branch into another track</FONT></TD></TR>
<TR><TD ALIGN="LEFT"><FONT COLOR="#37474F">- -&#9654; optional / supporting link</FONT></TD></TR>
<TR><TD ALIGN="LEFT"><FONT COLOR="#2E7D32">&#9632;</FONT> green = getting started / usage &#183; <FONT COLOR="#607D8B">&#9632;</FONT> grey = theory</TD></TR>
<TR><TD ALIGN="LEFT">blue = persistence &#183; amber = formal (both in part 2)</TD></TR>
</TABLE>>];

    // anchor the note + legend below the graph so they do not widen a rank
    see_part2 -> legend [style="invis"];
}
