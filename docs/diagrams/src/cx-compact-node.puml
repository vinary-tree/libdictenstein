@startuml cx-compact-node
' ============================================================================
' cx-compact-node.puml — conceptual field layout of a CX compact snapshot node.
' Replaces the ASCII record layout in docs/algorithms/native-u64-and-cx.md.
' A dense, path-compressed on-disk node (the AR64CX01 image). Fields, left→right:
'   is_final · prefix[≤PREFIX] · value? · children[(label,child); k]
' Color key:  a light→dark blue progression across the four fields (disk image).
' ============================================================================
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam ArrowColor #37474F
skinparam rectangle {
  BorderColor #1565C0
  FontColor #0D47A1
  BorderThickness 1.2
}
skinparam TitleFontSize 15

title CX compact node (conceptual on-disk layout)

rectangle "**is_final**\nleaf?" as F #E3F2FD
rectangle "**prefix**\n[u64; ≤ PREFIX]\nup to PREFIX collapsed labels" as P #BBDEFB
rectangle "**value?**\noptional" as V #90CAF9
rectangle "**children**\n[(u64, u64); k]\n(label, child) edges" as C #64B5F6

F -[hidden]right- P
P -[hidden]right- V
V -[hidden]right- C
@enduml
