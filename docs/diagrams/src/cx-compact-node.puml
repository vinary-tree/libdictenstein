@startuml cx-compact-node
' ============================================================================
' cx-compact-node.puml — conceptual field layout of a CX compact snapshot node.
' Replaces the ASCII record layout in docs/algorithms/native-u64-and-cx.md.
' A dense, path-compressed on-disk node (the AR64CX01 image). Drawn as a CONTIGUOUS
' colored field table (field + detail columns) hosted in a floating note; rows share
' borders (no gaps). Full-cell color via Creole |<#hex>| cells.
' Color key:  a light→dark blue progression across the four fields (disk image):
'             #E3F2FD is_final · #BBDEFB prefix · #90CAF9 value? · #64B5F6 children
' ============================================================================
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam TitleFontSize 15
skinparam noteFontSize 14
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #37474F
}

title CX compact node (conceptual on-disk layout)

note as CX
|= field |= detail |
|<#E3F2FD> is_final |<#E3F2FD> leaf? |
|<#BBDEFB> prefix : [u64; ≤ PREFIX] |<#BBDEFB> up to PREFIX collapsed labels |
|<#90CAF9> value? |<#90CAF9> optional |
|<#64B5F6> children : [(u64, u64); k] |<#64B5F6> (label, child) edges |
end note

legend bottom
| Color | Field |
|<#E3F2FD>| is_final (leaf flag) |
|<#BBDEFB>| collapsed prefix labels |
|<#90CAF9>| optional value |
|<#64B5F6>| (label, child) edges |
endlegend
@enduml
