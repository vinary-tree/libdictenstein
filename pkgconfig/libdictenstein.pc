prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: libdictenstein
Description: Snapshot-retaining high-performance dictionary backends
Version: 4.0.0-rc.4
Requires: vinary-tree-interop = 4.0.0-rc.4
Libs: -L${libdir} -llibdictenstein
Libs.private: -ldl -lpthread -lm
Cflags: -I${includedir}
