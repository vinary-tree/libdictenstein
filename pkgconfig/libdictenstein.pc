prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: libdictenstein
Description: High-performance dictionaries and trie-maps for approximate string matching
Version: 4.0.0-rc.6
Requires: vinary-tree-interop = 4.0.0-rc.6
Libs: -L${libdir} -llibdictenstein
Libs.private: -ldl -lpthread -lm
Cflags: -I${includedir}
